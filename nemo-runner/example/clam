<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Procedural Clam Obstacle</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #3498DB; }
        canvas { display: block; }
    </style>
</head>
<body>
    <!-- No extra canvas needed -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.module.min.js",
          "three/addons/": "https://unpkg.com/three@0.134.0/examples/jsm/"
        }
      }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { SimplexNoise } from 'three/addons/math/SimplexNoise.js'; // For shell texture

        let scene, camera, renderer, controls;
        let clamArray = []; // Store active clams
        const clock = new THREE.Clock();
        const simplex = new SimplexNoise();

        // --- Noise Functions (Copied) ---
        function hash(p) { /* ... */ let p_ = new THREE.Vector2(p.dot(new THREE.Vector2(127.1,311.7)), p.dot(new THREE.Vector2(269.5,183.3))); return -1.0 + 2.0 * new THREE.Vector2(Math.fract(Math.sin(p_.x)*43758.5453123), Math.fract(Math.sin(p_.y)*43758.5453123)); }
        function noise(p) { /* ... */ let i=p.clone().floor(); let f=p.clone().fract(); let u=f.clone().multiply(f).multiplyScalar(3.0).addScaledVector(f.clone().multiply(f).multiplyScalar(-2.0),1.0); let h00=hash(i); let h10=hash(i.clone().add(new THREE.Vector2(1.,0.))); let h01=hash(i.clone().add(new THREE.Vector2(0.,1.))); let h11=hash(i.clone().add(new THREE.Vector2(1.,1.))); let r1=h00.clone().addScaledVector(h10.clone().sub(h00),u.x); let r2=h01.clone().addScaledVector(h11.clone().sub(h01),u.x); return r1.clone().addScaledVector(r2.clone().sub(r1),u.y).x; }
        function fbm(p, octaves=3, persistence=0.5) { /* ... */ let t=0.; let f=1.; let a=1.; let mv=0.; for(let i=0;i<octaves;i++){t+=noise(p.clone().multiplyScalar(f))*a; mv+=a; a*=persistence; f*=2.;} return t/mv; }

        // --- Clam Shaders ---

        // Vertex shader (simple, could add noise deformation if desired)
        const clamVertexShader = `
            varying vec3 vNormal;
            varying vec3 vWorldPosition;
            varying vec2 vUv; // Pass UVs for texturing

            void main() {
                vUv = uv;
                vec4 worldPos = modelMatrix * vec4(position, 1.0);
                vWorldPosition = worldPos.xyz;
                vNormal = normalize(normalMatrix * normal); // Normal in view space
                gl_Position = projectionMatrix * viewMatrix * worldPos;
            }
        `;

        // Fragment shader for the OUTER shell (rough, textured)
        const clamOuterFragmentShader = `
            varying vec3 vNormal;
            varying vec3 vWorldPosition;
            varying vec2 vUv;

            uniform float uTime;
            uniform vec3 uBaseColor; // Base rock/shell color
            uniform sampler2D uCausticMap; // Optional caustics

            // Noise functions redeclared for fragment shader use
            float hashFS(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);} 
            float noiseFS(vec2 p){vec2 i=floor(p); vec2 f=fract(p); f=f*f*(3.-2.*f); float a=hashFS(i+vec2(0,0)); float b=hashFS(i+vec2(1,0)); float c=hashFS(i+vec2(0,1)); float d=hashFS(i+vec2(1,1)); return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);}
            float fbmFS(vec2 p,int o,float pe){float t=0.; float f=1.; float a=1.; float mv=0.; for(int i=0;i<o;i++){t+=noiseFS(p*f)*a; mv+=a; a*=pe; f*=2.;} return t/mv;}

            void main() {
                vec3 normal = normalize(vNormal);
                
                // --- Texture Generation ---
                // FBM noise for rough texture, use world position scaled
                float textureNoise = fbmFS(vWorldPosition.xz * 1.2, 4, 0.5); // Use 4 octaves
                // Create ridges using sine wave based on UVs or world position
                float ridges = sin(vWorldPosition.x * 5.0 + textureNoise * 10.0) * 0.5 + 0.5; // Adjust freq/amp
                ridges = smoothstep(0.6, 0.7, ridges); // Sharpen ridges into bands

                // Combine base color with noise and ridges
                vec3 baseColor = uBaseColor * (0.8 + textureNoise * 0.2); // Base color variation
                baseColor = mix(baseColor * 0.8, baseColor * 1.1, ridges); // Darker grooves, lighter ridges

                // --- Lighting ---
                vec3 viewDir = normalize(cameraPosition - vWorldPosition);
                vec3 lightDir = normalize(vec3(0.4, 0.9, 0.3));
                float diff = max(dot(normal, lightDir), 0.0);
                vec3 halfwayDir = normalize(lightDir + viewDir);
                float specAngle = max(dot(normal, halfwayDir), 0.0);
                float spec = pow(specAngle, 8.0) * 0.2; // Low, rough specular
                vec3 litColor = baseColor * (diff * 0.7 + 0.3) + vec3(spec);

                // --- Caustics ---
                vec2 causticUv = vWorldPosition.xz * 0.08 + vec2(uTime * 0.03, uTime * 0.02); 
                vec3 caustics = texture2D(uCausticMap, causticUv).rgb * 0.1;

                gl_FragColor = vec4(litColor + caustics, 1.0); // Opaque
                gl_FragColor.rgb = pow(gl_FragColor.rgb, vec3(1.0/2.2)); 
            }
        `;

        // Fragment shader for the INNER shell (smooth, pearlescent)
        const clamInnerFragmentShader = `
            varying vec3 vNormal;
            varying vec3 vWorldPosition;
            varying vec2 vUv;

            uniform float uTime;
            uniform vec3 uColor1; // Pearlescent color 1
            uniform vec3 uColor2; // Pearlescent color 2
            uniform sampler2D uCausticMap;

            // Fresnel calculation included here
            float calculateFresnel(vec3 normal, vec3 viewDir) {
                 return pow(1.0 + dot(viewDir, normal), 3.5); // Adjust power for edge glow intensity
            }

            void main() {
                vec3 normal = normalize(vNormal);
                vec3 viewDir = normalize(cameraPosition - vWorldPosition);

                // --- Fresnel Effect ---
                float fresnel = calculateFresnel(normal, viewDir);
                fresnel = smoothstep(0.0, 1.0, fresnel) * 0.7 + 0.3; // Map to a usable range

                // --- Iridescence Effect (Simple noise-based color shift) ---
                // Use view angle and noise to shift between two colors
                float incidenceAngle = dot(normal, viewDir); // Angle between surface and view
                 float noiseShift = noiseFS(vWorldPosition.xz * 1.5 + uTime * 0.1);
                float iridescenceFactor = sin((incidenceAngle + noiseShift) * 5.0) * 0.5 + 0.5; // Oscillate based on angle+noise
                vec3 iridescentColor = mix(uColor1, uColor2, iridescenceFactor);

                // --- Basic Lighting ---
                vec3 lightDir = normalize(vec3(0.4, 0.9, 0.3));
                float diff = max(dot(normal, lightDir), 0.0);
                vec3 halfwayDir = normalize(lightDir + viewDir);
                float specAngle = max(dot(normal, halfwayDir), 0.0);
                float spec = pow(specAngle, 40.0) * 0.8; // High, sharp specular for pearl finish
                
                // Combine: Base iridescence + Lighting + Fresnel Glow
                vec3 baseLit = iridescentColor * (diff * 0.5 + 0.5) + vec3(spec); // Ambient + Diffuse + Specular
                vec3 finalColor = mix(baseLit, iridescentColor * 1.5, fresnel * 0.5); // Add fresnel glow

                 // --- Caustics ---
                vec2 causticUv = vWorldPosition.xz * 0.08 + vec2(uTime * 0.03, uTime * 0.02); 
                vec3 caustics = texture2D(uCausticMap, causticUv).rgb * 0.1;

                gl_FragColor = vec4(finalColor + caustics, 1.0); // Opaque
                 gl_FragColor.rgb = pow(gl_FragColor.rgb, vec3(1.0/2.2)); 
            }
        `;

        // --- Clam Geometry ---
        /**
         * Creates geometry for one half of the clam shell.
         * @param {boolean} isTopHalf - Determines orientation.
         * @param {number} radius - Radius of the clam.
         * @param {number} segments - Detail level.
         */
        function createClamShellHalfGeometry(isTopHalf = false, radius = 1.0, segments = 32) {
            // Create a sphere segment (hemisphere)
            const geometry = new THREE.SphereGeometry(
                radius, 
                segments, 
                Math.max(16, segments / 2), // phiSegments
                0, // phiStart
                Math.PI * 2, // phiLength
                0, // thetaStart
                Math.PI / 2 // thetaLength (hemisphere)
            );

            // Rotate if it's the top half
            if (isTopHalf) {
                geometry.rotateX(Math.PI); 
            }

            // Optional: Add slight noise deformation for irregularity
            const positions = geometry.attributes.position;
            const vertex = new THREE.Vector3();
            const noiseFreq = 1.5 / radius; const noiseAmp = 0.03 * radius;
             for (let i = 0; i < positions.count; i++) {
                 vertex.fromBufferAttribute(positions, i);
                 let noiseVal = simplex.noise3D(vertex.x*noiseFreq, vertex.y*noiseFreq, vertex.z*noiseFreq) * noiseAmp;
                 vertex.addScaledVector(vertex.clone().normalize(), noiseVal); 
                 positions.setXYZ(i, vertex.x, vertex.y, vertex.z);
             }
            geometry.computeVertexNormals();
            geometry.attributes.position.needsUpdate = true;

            return geometry;
        }

        // --- Clam Materials ---
        let clamOuterMaterial = null;
        let clamInnerMaterial = null;
        let pearlMaterial = null;

        function initClamMaterials(causticTex) {
            clamOuterMaterial = new THREE.ShaderMaterial({
                vertexShader: clamVertexShader,
                fragmentShader: clamOuterFragmentShader,
                uniforms: {
                    uTime: { value: 0.0 },
                    uBaseColor: { value: new THREE.Color(0xAC8C6F) }, // Sandy Brown/Grey
                    uCausticMap: { value: causticTex }
                },
                side: THREE.FrontSide // Only render outside
            });

            clamInnerMaterial = new THREE.ShaderMaterial({
                vertexShader: clamVertexShader,
                fragmentShader: clamInnerFragmentShader,
                uniforms: {
                    uTime: { value: 0.0 },
                    uColor1: { value: new THREE.Color(0xF0F8FF) }, // AliceBlue
                    uColor2: { value: new THREE.Color(0xFFE4E1) }, // MistyRose
                    uCausticMap: { value: causticTex }
                },
                 side: THREE.BackSide // Only render inside
            });
            
            pearlMaterial = new THREE.MeshStandardMaterial({
                 color: 0xFFFAF0, // FloralWhite
                 roughness: 0.1,
                 metalness: 0.2,
                 emissive: 0xE0E0E0, // Slight self-glow
                 envMapIntensity: 1.5 // Enhance reflections if env map is present
            });
        }

        // --- Clam Assembly ---
        /**
         * Creates a complete Clam obstacle object group.
         * @param {object} options - Configuration.
         * @param {number} [options.scale=1] - Overall size.
         * @param {boolean} [options.hasPearl=true] - Whether it contains a pearl.
         * @param {number} [options.openAngle=Math.PI/3] - Max angle the top shell opens (radians).
         * @param {number} [options.openDuration=1.5] - Time spent fully open.
         * @param {number} [options.closedDuration=2.0] - Time spent fully closed.
         * @param {number} [options.transitionDuration=0.5] - Time to open/close.
         */
        function createClam(options = {}) {
            const {
                scale = 0.8 + Math.random() * 0.7,
                hasPearl = Math.random() < 0.3, // 30% chance of pearl
                openAngle = Math.PI / 3.5 + (Math.random() - 0.5) * 0.2,
                openDuration = 1.2 + Math.random(),
                closedDuration = 1.5 + Math.random() * 1.5,
                transitionDuration = 0.4 + Math.random() * 0.2
            } = options;
            
            if (!clamOuterMaterial || !clamInnerMaterial) {
                 console.error("Clam materials not initialized!");
                 return null;
            }

            const group = new THREE.Group();
            group.scale.set(scale, scale, scale);

            // Hinge point - Group for the top shell to rotate around
            const hinge = new THREE.Group();
            group.add(hinge);

            // Create Shell Halves using shared materials
            const radius = 1.0; // Base radius before scaling
            const bottomShellGeo = createClamShellHalfGeometry(false, radius);
            const topShellGeo = createClamShellHalfGeometry(true, radius);
            
            // Need two meshes per half for inner/outer materials
            const bottomOuterMesh = new THREE.Mesh(bottomShellGeo, clamOuterMaterial);
            const bottomInnerMesh = new THREE.Mesh(bottomShellGeo, clamInnerMaterial);
            const topOuterMesh = new THREE.Mesh(topShellGeo, clamOuterMaterial);
            const topInnerMesh = new THREE.Mesh(topShellGeo, clamInnerMaterial);
            
            bottomOuterMesh.castShadow = true; bottomOuterMesh.receiveShadow = true;
            topOuterMesh.castShadow = true; //topOuterMesh.receiveShadow = true; // Inner side doesn't need receive?

            group.add(bottomOuterMesh, bottomInnerMesh);
            hinge.add(topOuterMesh, topInnerMesh); // Add top shell parts to the hinge group

            // Store references
            group.userData.topShellHinge = hinge;
            group.userData.topShellOuter = topOuterMesh;
            group.userData.bottomShellOuter = bottomOuterMesh; // Needed for collision

            // Add Pearl
            if (hasPearl) {
                const pearlGeo = new THREE.SphereGeometry(radius * 0.15, 16, 12); // Pearl size relative to clam
                const pearlMesh = new THREE.Mesh(pearlGeo, pearlMaterial);
                pearlMesh.position.y = radius * 0.05; // Position slightly above bottom shell center
                group.add(pearlMesh);
                group.userData.pearl = pearlMesh;
                pearlMesh.castShadow = true;
            }

            // Animation State
            group.userData.state = 'CLOSED'; // CLOSED, OPENING, OPEN, CLOSING
            group.userData.timer = Math.random() * (openDuration + closedDuration); // Start at random point in cycle
            group.userData.openAngle = openAngle;
            group.userData.openDuration = openDuration;
            group.userData.closedDuration = closedDuration;
            group.userData.transitionDuration = transitionDuration;
            
            group.userData.update = updateClamAnimation; // Assign update function

            return group;
        }

        // --- Clam Animation Update Logic ---
        function updateClamAnimation(time, deltaTime) {
            // 'this' refers to the clam group (group.userData.update = updateClamAnimation)
            this.userData.timer += deltaTime;
            const cycleDuration = this.userData.openDuration + this.userData.closedDuration + 2 * this.userData.transitionDuration;
            const timeInCycle = this.userData.timer % cycleDuration;

            let targetAngle = 0;
            let newState = this.userData.state;

            // Determine state and target angle based on time in cycle
            if (timeInCycle < this.userData.closedDuration) {
                newState = 'CLOSED';
                targetAngle = 0;
            } else if (timeInCycle < this.userData.closedDuration + this.userData.transitionDuration) {
                newState = 'OPENING';
                const progress = (timeInCycle - this.userData.closedDuration) / this.userData.transitionDuration;
                targetAngle = THREE.MathUtils.lerp(0, this.userData.openAngle, progress * progress); // Ease in opening
            } else if (timeInCycle < this.userData.closedDuration + this.userData.transitionDuration + this.userData.openDuration) {
                newState = 'OPEN';
                targetAngle = this.userData.openAngle;
            } else { // Closing
                newState = 'CLOSING';
                 const progress = (timeInCycle - (this.userData.closedDuration + this.userData.transitionDuration + this.userData.openDuration)) / this.userData.transitionDuration;
                 targetAngle = THREE.MathUtils.lerp(this.userData.openAngle, 0, 1.0 - (1.0 - progress) * (1.0 - progress)); // Ease out closing
            }

            // Play sound on state change (implement audioManager calls here)
            if (newState !== this.userData.state) {
                 // if (newState === 'OPENING') audioManager.playSound('clam_open');
                 // if (newState === 'CLOSING') audioManager.playSound('clam_close');
                 this.userData.state = newState;
                 // console.log("Clam state:", newState);
            }

            // Smoothly rotate the hinge group towards the target angle
            const hinge = this.userData.topShellHinge;
            hinge.rotation.x = THREE.MathUtils.lerp(hinge.rotation.x, targetAngle, 0.15); // Adjust lerp factor for smoothness

            // Update shader time uniforms (optional, if shaders use time)
             this.traverse((child) => {
                 if(child.isMesh && child.material?.uniforms?.uTime) {
                     child.material.uniforms.uTime.value = time;
                 }
             });
        }


        // --- Caustic Effect (Copied) ---
        function createCausticTexture(size = 256) { /* ... */ causticCanvas=document.getElementById('dynamicTextureCanvas');if (!causticCanvas){causticCanvas=document.createElement('canvas');} causticCanvas.width=size; causticCanvas.height=size; causticCtx=causticCanvas.getContext('2d'); const t=new THREE.CanvasTexture(causticCanvas); t.wrapS=t.wrapT=THREE.RepeatWrapping; t.minFilter=THREE.LinearFilter; return t;}
        function updateCausticTexture(texture, time) { /* ... */ const s=texture.image.width; const c=causticCtx; c.fillStyle='rgb(15,15,25)'; c.fillRect(0,0,s,s); const l=4; for(let i=0;i<l;i++){ c.strokeStyle=`rgba(${180+Math.random()*50},${210+Math.random()*45},255,${0.05+Math.random()*0.05})`; c.lineWidth=Math.random()*1.5+1.; c.beginPath(); const f=(i+1)*.04+.03; const a=s*.18; const sp=(i+1)*.25+.15; const ox=Math.sin(time*sp*.6+i*2.)*s*.25; const oy=Math.cos(time*sp*.45+i*3.)*s*.25; for(let x=0;x<s;x++){ const y=Math.sin((x+ox)*f+time*sp+Math.cos(x*.03)*.5)*a+s/2+oy+Math.cos(x*.04+time*.15+i*1.5)*15; if(x===0)c.moveTo(x,y); else c.lineTo(x,y); } c.stroke(); } texture.needsUpdate=true; }

        // --- Initialization ---
        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x3498DB); 
            scene.fog = new THREE.Fog(0x3498DB, 15, 50); 

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100); 
            camera.position.set(0, 2, 8); 

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            renderer.toneMapping = THREE.ACESFilmicToneMapping; 
            renderer.outputEncoding = THREE.sRGBEncoding; 
            renderer.shadowMap.enabled = true; // Shadows look good on clams
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            document.body.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0x80B0FF, 0.6); 
            scene.add(ambientLight);
            const directionalLight = new THREE.DirectionalLight(0xFFF5E0, 1.0); 
            directionalLight.position.set(8, 15, 10);
            directionalLight.castShadow = true; 
             directionalLight.shadow.mapSize.width = 1024; directionalLight.shadow.mapSize.height = 1024;
             directionalLight.shadow.camera.near = 1; directionalLight.shadow.camera.far = 40;
             directionalLight.shadow.camera.left = -15; directionalLight.shadow.camera.right = 15;
             directionalLight.shadow.camera.top = 15; directionalLight.shadow.camera.bottom = -15;
            scene.add(directionalLight);
            // scene.add( new THREE.CameraHelper( directionalLight.shadow.camera ) ); // Debug shadows

            // Caustic Setup
            causticTexture = createCausticTexture(256); 

            // Initialize shared clam materials
            initClamMaterials(causticTexture);

            // Controls
            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.target.set(0, 0, 0); 

            // Create Example Clams
            for (let i = 0; i < 5; i++) {
                const clam = createClam({ scale: 1.2 + Math.random() * 0.6 });
                if (clam) {
                     clam.position.set(
                         (Math.random() - 0.5) * 15,
                         -0.1, // Position slightly below origin (will rest on floor later)
                         (Math.random() - 0.5) * 10 - 5
                     );
                     clam.rotation.y = Math.random() * Math.PI * 2;
                    scene.add(clam);
                    clamArray.push(clam);
                }
            }
            
            // Optional floor for context
             const floorGeo = new THREE.PlaneGeometry(30,30);
             const floorMat = new THREE.MeshStandardMaterial({color: 0x806040, roughness: 0.8});
             const floor = new THREE.Mesh(floorGeo, floorMat);
             floor.rotation.x = -Math.PI/2;
             floor.position.y = -1.1; // Adjust so clams sit on it
             floor.receiveShadow = true;
             scene.add(floor);

            window.addEventListener('resize', onWindowResize);
        }
        
        // --- Resize Handler ---
        function onWindowResize() { 
             camera.aspect = window.innerWidth / window.innerHeight;
             camera.updateProjectionMatrix();
             renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // --- Animation Loop ---
        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();
            const deltaTime = clock.getDelta();

            if (causticTexture) { updateCausticTexture(causticTexture, elapsedTime); }

            // Update Clams
            clamArray.forEach(clam => {
                if (clam.userData.update) {
                     clam.userData.update(elapsedTime, deltaTime);
                }
            });
            
            controls.update(); 
            renderer.render(scene, camera);
        }

        init();
        animate();

    </script>
</body>
</html>