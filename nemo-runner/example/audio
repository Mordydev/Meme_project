<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audio Manager Implementation</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #3498DB; font-family: sans-serif; color: white; }
        canvas { display: block; }
        #info { position: absolute; top: 10px; width: 100%; text-align: center; z-index: 10;}
        #info button, #info label, #info input { margin: 5px; padding: 8px 12px; color: #333; }
        #unlockOverlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.7); color: white;
            display: flex; justify-content: center; align-items: center;
            font-size: 1.5em; text-align: center; cursor: pointer; z-index: 20;
        }
    </style>
</head>
<body>
    <!-- Unlock Overlay -->
    <div id="unlockOverlay">Click or Tap anywhere to enable audio</div>

    <!-- UI Controls -->
    <div id="info">
        <button id="sfxBtn">Play SFX (Collect)</button>
        <button id="musicPlayBtn">Play Music</button>
        <button id="musicStopBtn">Stop Music</button>
        <br>
        <label>Master Vol: <input type="range" id="masterVol" min="0" max="1" step="0.05" value="0.8"></label>
        <label>Music Vol: <input type="range" id="musicVol" min="0" max="1" step="0.05" value="0.6"></label>
        <label>SFX Vol: <input type="range" id="sfxVol" min="0" max="1" step="0.05" value="0.9"></label>
    </div>

    <!-- Canvas for the game (optional here) -->
    <canvas id="gameCanvas"></canvas> 

    <!-- Three.js (optional for this demo, but usually present) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <!-- ... other imports ... -->

    <script type="module">
        // No Three.js imports needed for AudioManager itself

        // --- Audio Manager Class ---
        class AudioManager {
            constructor() {
                this.audioContext = null;
                this.masterGain = null;
                this.musicGain = null;
                this.sfxGain = null;
                this.soundBuffers = new Map(); // Stores loaded AudioBuffers by name
                this.currentMusicSource = null; // Reference to the currently playing music node
                this.isUnlocked = false; // Tracks if user interaction has occurred
                this.isLoading = false;
                this.soundsToLoad = 0;
                this.soundsLoaded = 0;

                // Attempt to create AudioContext immediately
                try {
                     this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                     this._initNodes();
                } catch (e) {
                     console.error("Web Audio API is not supported in this browser", e);
                     // Provide fallback or disable audio features
                }
            }

            // Initialize Gain Nodes
            _initNodes() {
                if (!this.audioContext) return;
                this.masterGain = this._createGainNode(0.8); // Master volume default 80%
                this.musicGain = this._createGainNode(0.6);  // Music volume default 60%
                this.sfxGain = this._createGainNode(0.9);    // SFX volume default 90%

                // Connect nodes: Source -> Specific Gain -> Master Gain -> Destination
                this.musicGain.connect(this.masterGain);
                this.sfxGain.connect(this.masterGain);
                this.masterGain.connect(this.audioContext.destination);
            }

             // Helper to create a Gain Node
            _createGainNode(initialVolume = 1.0) {
                if (!this.audioContext) return null;
                const gainNode = this.audioContext.createGain();
                gainNode.gain.setValueAtTime(initialVolume, this.audioContext.currentTime);
                return gainNode;
            }

            // Unlock audio context on first user interaction
            unlockAudio() {
                if (!this.audioContext || this.isUnlocked) return;
                
                this.audioContext.resume().then(() => {
                    console.log("AudioContext resumed successfully.");
                    this.isUnlocked = true;
                    // Optionally play a short silent buffer to ensure readiness on some browsers
                    const buffer = this.audioContext.createBuffer(1, 1, 22050);
                    const source = this.audioContext.createBufferSource();
                    source.buffer = buffer;
                    source.connect(this.audioContext.destination);
                    source.start(0);
                    source.stop(this.audioContext.currentTime + 0.001); 
                    
                    // Hide overlay
                     const overlay = document.getElementById('unlockOverlay');
                     if (overlay) overlay.style.display = 'none';

                }).catch(e => {
                    console.error("Error resuming AudioContext:", e);
                });
            }

            // Load a single sound file
            async loadSound(url, name) {
                if (!this.audioContext || this.soundBuffers.has(name)) {
                    // console.warn(`Sound "${name}" already loaded or AudioContext not available.`);
                    return this.soundBuffers.get(name) || null; // Return existing buffer if already loaded
                }
                
                this.isLoading = true;
                this.soundsToLoad++;
                console.log(`Loading sound: ${name} from ${url}`);

                try {
                    const response = await fetch(url);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status} for ${url}`);
                    }
                    const arrayBuffer = await response.arrayBuffer();
                    const audioBuffer = await this.audioContext.decodeAudioData(arrayBuffer);
                    
                    this.soundBuffers.set(name, audioBuffer);
                    console.log(`Sound loaded: ${name}`);
                    this.soundsLoaded++;
                    if (this.soundsLoaded >= this.soundsToLoad) {
                        this.isLoading = false;
                        console.log("All sounds loaded.");
                    }
                    return audioBuffer;

                } catch (error) {
                    console.error(`Error loading sound "${name}":`, error);
                    this.soundsLoaded++; // Still count as "attempted"
                     if (this.soundsLoaded >= this.soundsToLoad) {
                        this.isLoading = false;
                    }
                    return null;
                }
            }

            // Load multiple sounds from a list [{name: '...', url: '...'}, ...]
            async loadSounds(soundList) {
                 if (!this.audioContext) return;
                 this.soundsToLoad = 0; // Reset counts for batch loading
                 this.soundsLoaded = 0;
                 const promises = soundList.map(sound => this.loadSound(sound.url, sound.name));
                 await Promise.all(promises);
            }
            
            // Internal function to play a loaded buffer
            _playSoundBuffer(buffer, volume, loop, targetNode) {
                 if (!this.audioContext || !buffer || !targetNode || !this.isUnlocked) {
                     console.warn("Cannot play sound - AudioContext not ready, buffer missing, target missing, or context locked.");
                     return null; 
                 }

                 const source = this.audioContext.createBufferSource();
                 source.buffer = buffer;
                 
                 // Create a dedicated gain node for this sound instance for individual volume control
                 const individualGain = this.audioContext.createGain();
                 individualGain.gain.setValueAtTime(volume, this.audioContext.currentTime);
                 
                 source.connect(individualGain); // Source -> Individual Gain
                 individualGain.connect(targetNode); // Individual Gain -> Target Gain (Music/SFX)

                 source.loop = loop;
                 source.start(this.audioContext.currentTime);

                 // Add a callback for when the sound finishes playing (if not looping)
                 if (!loop) {
                    source.onended = () => {
                         // Clean up nodes to prevent memory leaks
                         source.disconnect();
                         individualGain.disconnect();
                         // console.log("Sound finished and disconnected");
                    };
                 }
                 
                 return source; // Return the source node for potential external control (e.g., stopping)
            }

            // Play a sound effect by name
            playSound(name, volume = 1.0) {
                if (!this.sfxGain) return null;
                const buffer = this.soundBuffers.get(name);
                if (buffer) {
                    return this._playSoundBuffer(buffer, volume, false, this.sfxGain);
                } else {
                    console.warn(`Sound effect "${name}" not found.`);
                    return null;
                }
            }

            // Play music by name
            playMusic(name, loop = true, fadeDuration = 0.5, volume = 1.0) {
                if (!this.musicGain) return null;
                const buffer = this.soundBuffers.get(name);
                if (buffer) {
                    this.stopMusic(fadeDuration); // Fade out any current music first
                    
                    // Use a slight delay before starting new music if fading out
                    const startTime = this.audioContext.currentTime + (this.currentMusicSource ? fadeDuration * 0.5 : 0); 
                    
                    // Start the new music after the delay
                    setTimeout(() => {
                        if (!this.musicGain) return; // Check again in case context was lost
                        this.currentMusicSource = this._playSoundBuffer(buffer, volume, loop, this.musicGain);
                         console.log(`Playing music: ${name}`);
                    }, startTime * 1000 - this.audioContext.currentTime * 1000); // Timeout in milliseconds

                } else {
                    console.warn(`Music track "${name}" not found.`);
                    return null;
                }
            }

            // Stop a specific sound source node immediately
            stopSound(sourceNode) {
                if (sourceNode) {
                    try {
                        sourceNode.stop();
                         // No need to call disconnect here if onended handles it
                    } catch (e) {
                         console.warn("Error stopping sound:", e); // Can happen if already stopped
                    }
                }
            }

            // Stop currently playing music with optional fade
            stopMusic(fadeDuration = 0.5) {
                if (this.currentMusicSource && this.musicGain) {
                    const sourceToStop = this.currentMusicSource; // Keep reference
                    const initialVolume = this.musicGain.gain.value; // Get current music volume
                     const now = this.audioContext.currentTime;
                    
                    // Fade out the *music gain node itself* (affects only music)
                    this.musicGain.gain.cancelScheduledValues(now); // Cancel previous ramps
                    this.musicGain.gain.setValueAtTime(initialVolume, now);
                    this.musicGain.gain.linearRampToValueAtTime(0.001, now + fadeDuration); // Fade to near zero

                    // Schedule the source node to stop slightly after fade ends
                    setTimeout(() => {
                         this.stopSound(sourceToStop);
                          // Reset music gain node volume for next track (after a short delay)
                          setTimeout(() => {
                              if(this.musicGain) {
                                   this.musicGain.gain.setValueAtTime(initialVolume, this.audioContext.currentTime);
                              }
                          }, 100); // Delay reset slightly
                    }, fadeDuration * 1000 + 50); // Stop 50ms after fade should end

                    this.currentMusicSource = null;
                    console.log("Stopping music...");
                }
            }

            // Set volume levels with ramps for smooth changes
            setMasterVolume(volume, rampTime = 0.05) {
                 if (this.masterGain) {
                     this.masterGain.gain.linearRampToValueAtTime(Math.max(0, volume), this.audioContext.currentTime + rampTime);
                 }
            }
             setMusicVolume(volume, rampTime = 0.05) {
                 if (this.musicGain) {
                     this.musicGain.gain.linearRampToValueAtTime(Math.max(0, volume), this.audioContext.currentTime + rampTime);
                 }
            }
             setSfxVolume(volume, rampTime = 0.05) {
                 if (this.sfxGain) {
                     this.sfxGain.gain.linearRampToValueAtTime(Math.max(0, volume), this.audioContext.currentTime + rampTime);
                 }
            }
        }

        // --- Global Audio Manager Instance ---
        const audioManager = new AudioManager();


        // --- Initialization ---
        function init() {
            // Scene setup (optional for audio demo)
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('gameCanvas'), antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            camera.position.z = 5;

            // --- Load Sounds ---
            // Replace with actual URLs to your sound files!
            const sounds = [
                { name: 'collect_bubble', url: 'sounds/collect_bubble.wav' }, // Placeholder URL
                { name: 'collect_powerup', url: 'sounds/collect_powerup.wav' }, // Placeholder URL
                { name: 'jump', url: 'sounds/jump.wav' },           // Placeholder URL
                { name: 'dive', url: 'sounds/dive.wav' },           // Placeholder URL
                { name: 'hit', url: 'sounds/hit.wav' },            // Placeholder URL
                { name: 'music_main', url: 'sounds/music_main_loop.mp3' }, // Placeholder URL
                { name: 'music_menu', url: 'sounds/music_menu.mp3' }  // Placeholder URL
            ];
             audioManager.loadSounds(sounds).then(() => {
                 console.log("Audio loading complete (or attempted).");
                 // Ready to play sounds now
             });

            // --- Setup UI Event Listeners ---
            const unlockOverlay = document.getElementById('unlockOverlay');
            const sfxButton = document.getElementById('sfxBtn');
            const musicPlayButton = document.getElementById('musicPlayBtn');
            const musicStopButton = document.getElementById('musicStopBtn');
            const masterVolSlider = document.getElementById('masterVol');
            const musicVolSlider = document.getElementById('musicVol');
            const sfxVolSlider = document.getElementById('sfxVol');

             // Unlock audio on first interaction
             const unlockHandler = () => {
                 audioManager.unlockAudio();
                 unlockOverlay.removeEventListener('click', unlockHandler);
                 unlockOverlay.removeEventListener('touchstart', unlockHandler);
             };
             unlockOverlay.addEventListener('click', unlockHandler);
             unlockOverlay.addEventListener('touchstart', unlockHandler);


            sfxButton.addEventListener('click', () => {
                audioManager.playSound('collect_powerup', 0.8); // Play SFX by name
            });
            musicPlayButton.addEventListener('click', () => {
                audioManager.playMusic('music_main'); // Play music track by name
            });
             musicStopButton.addEventListener('click', () => {
                audioManager.stopMusic(1.0); // Stop music with 1s fade
            });

            masterVolSlider.addEventListener('input', (e) => audioManager.setMasterVolume(parseFloat(e.target.value)));
            musicVolSlider.addEventListener('input', (e) => audioManager.setMusicVolume(parseFloat(e.target.value)));
            sfxVolSlider.addEventListener('input', (e) => audioManager.setSfxVolume(parseFloat(e.target.value)));
            
            // Set initial slider values from AudioManager defaults
            if(audioManager.masterGain) masterVolSlider.value = audioManager.masterGain.gain.value;
            if(audioManager.musicGain) musicVolSlider.value = audioManager.musicGain.gain.value;
            if(audioManager.sfxGain) sfxVolSlider.value = audioManager.sfxGain.gain.value;

            window.addEventListener('resize', onWindowResize);
        }
        
        // --- Resize Handler ---
        function onWindowResize() { 
             camera.aspect = window.innerWidth / window.innerHeight;
             camera.updateProjectionMatrix();
             renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // --- Animation Loop (minimal for demo) ---
        function animate() {
            requestAnimationFrame(animate);
            // Update game logic...
            // Update 3D elements...
            renderer.render(scene, camera);
        }

        init();
        animate();

    </script>
</body>
</html>