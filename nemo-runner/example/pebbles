<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instanced Pebbles & Shells on Seafloor</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #3498DB; }
        canvas { display: block; }
    </style>
</head>
<body>
    <canvas id="dynamicTextureCanvas" style="display:none;"></canvas> 
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.module.min.js",
          "three/addons/": "https://unpkg.com/three@0.134.0/examples/jsm/"
        }
      }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { SimplexNoise } from 'three/addons/math/SimplexNoise.js';

        let scene, camera, renderer, controls;
        let floorMesh; 
        let causticTexture, causticCanvas, causticCtx;
        let detailMeshesGroup = new THREE.Group(); // Group to hold all instanced meshes
        const clock = new THREE.Clock();
        const simplex = new SimplexNoise();
        const raycaster = new THREE.Raycaster();
        const UP_VECTOR = new THREE.Vector3(0, 1, 0);
        const DOWN_VECTOR = new THREE.Vector3(0, -1, 0);

        // --- Noise Functions (Copied) ---
        function hash(p){/*...*/} function noise(p){/*...*/} function fbm(p,o=4,pe=0.5){/*...*/}

        // --- Shaders (Using Floor Shader for consistency) ---
        const floorVertexShader = `/* ... Same as Environment/Obstacle ... */
            varying vec3 vNormal; varying vec3 vWorldPosition; varying float vSlope;
            void main() { vec3 worldNormal = normalize((modelMatrix * vec4(normal, 0.0)).xyz); vNormal = normalize(normalMatrix * normal); vec4 worldPos = modelMatrix * vec4(position, 1.0); vWorldPosition = worldPos.xyz; vSlope = max(0.0, dot(worldNormal, vec3(0.0, 1.0, 0.0))); gl_Position = projectionMatrix * viewMatrix * worldPos; }`;
        const floorFragmentShader = `/* ... Same as Environment/Obstacle ... */
             uniform vec3 uSandColor; uniform vec3 uRockColor; uniform vec3 uWetSandColor; uniform float uTime; uniform sampler2D uCausticMap; 
             varying vec3 vNormal; varying vec3 vWorldPosition; varying float vSlope;
             float hashFS(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);} float noiseFS(vec2 p){vec2 i=floor(p); vec2 f=fract(p); f=f*f*(3.-2.*f); float a=hashFS(i+vec2(0,0)); float b=hashFS(i+vec2(1,0)); float c=hashFS(i+vec2(0,1)); float d=hashFS(i+vec2(1,1)); return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);} float fbmFS(vec2 p, int o, float pe){float v=0.;float a=1.;float f=1.;float mv=0.;for(int i=0; i<o;++i){v+=noiseFS(p*f)*a; mv+=a; a*=pe; f*=2.;} return v/mv;}
             void main() { vec3 n=normalize(vNormal); float slopeMix=smoothstep(.6,.9,vSlope); vec3 slopeColor=mix(uRockColor,uSandColor,slopeMix); float heightMix=smoothstep(-3.,-1.,vWorldPosition.y); vec3 baseColor=mix(slopeColor,uWetSandColor*(.7+uRockColor*.3),1.-heightMix); float detailNoise=fbmFS(vWorldPosition.xz*.8,3,.45); baseColor+=detailNoise*.08; vec3 viewDir=normalize(cameraPosition-vWorldPosition); vec3 lightDir=normalize(vec3(.5,.8,.4)); float diff=max(dot(n,lightDir),0.); vec3 halfwayDir=normalize(lightDir+viewDir); float specAngle=max(dot(n,halfwayDir),0.); float spec=pow(specAngle,16.)*(.3+slopeMix*.3); vec3 litColor=baseColor*(diff*.8+.25)+vec3(spec*.4); vec2 causticUv=vWorldPosition.xz*.08+vec2(uTime*.03,uTime*.02); vec3 caustics=texture2D(uCausticMap,causticUv).rgb*.18; gl_FragColor=vec4(litColor+caustics,1.); gl_FragColor.rgb=pow(gl_FragColor.rgb,vec3(1./2.2)); }`;

        // --- Detail Geometry Creation ---

        /** Creates a simple, slightly noisy pebble geometry. */
        function createPebbleGeometry(radius = 0.1, detail = 0) {
             const geometry = new THREE.IcosahedronGeometry(radius, detail);
             const positions = geometry.attributes.position;
             const vertex = new THREE.Vector3();
             const noiseFreq = 5.0 / radius; const noiseAmp = 0.15 * radius;
              for (let i = 0; i < positions.count; i++) {
                 vertex.fromBufferAttribute(positions, i);
                 let noiseVal = simplex.noise3D(vertex.x*noiseFreq, vertex.y*noiseFreq, vertex.z*noiseFreq) * noiseAmp;
                 vertex.addScaledVector(vertex.clone().normalize(), noiseVal); 
                 positions.setXYZ(i, vertex.x, vertex.y, vertex.z);
             }
             geometry.computeVertexNormals();
             geometry.attributes.position.needsUpdate = true;
             return geometry;
        }
        
        /** Creates a simple, conical shell geometry. */
        function createConicalShellGeometry(radius = 0.08, height = 0.25, detail = 6) {
            const geometry = new THREE.ConeGeometry(radius, height, detail, 1); // Radius, Height, RadialSegments, HeightSegments
            geometry.translate(0, height * 0.5, 0); // Base at origin
            // Add slight twist/bend? (More complex)
             const positions = geometry.attributes.position;
             const vertex = new THREE.Vector3();
             const twistFreq = 2.0 / height; const twistAmp = 0.1 * radius;
              for (let i = 0; i < positions.count; i++) {
                  vertex.fromBufferAttribute(positions, i);
                  const angle = Math.atan2(vertex.z, vertex.x); // Angle around Y
                  const twistOffset = Math.sin(vertex.y * twistFreq * Math.PI) * twistAmp;
                  vertex.x += Math.cos(angle + Math.PI/2) * twistOffset; // Add offset perpendicular to radius
                  vertex.z += Math.sin(angle + Math.PI/2) * twistOffset;
                  positions.setXYZ(i, vertex.x, vertex.y, vertex.z);
              }

            geometry.computeVertexNormals();
             geometry.attributes.position.needsUpdate = true;
            return geometry;
        }

        /** Creates a simple, flat spiral shell geometry. */
        function createSpiralShellGeometry(radius = 0.15, spirals = 3, detail = 16) {
             const shape = new THREE.Shape();
             const points = [];
             for (let i = 0; i <= detail * spirals; i++) {
                 const angle = (i / (detail*spirals)) * Math.PI * 2 * spirals;
                 const r = radius * (i / (detail*spirals)); // Radius increases with angle
                 points.push(new THREE.Vector2(Math.cos(angle) * r, Math.sin(angle) * r));
             }
             shape.splineThru(points); // Create smooth curve

             const extrudeSettings = { depth: 0.03, bevelEnabled: true, bevelSize: 0.005, bevelSegments: 1 };
             const geometry = new THREE.ExtrudeGeometry(shape, extrudeSettings);
             geometry.center();
             geometry.rotateX(Math.PI / 2); // Lay flat
             geometry.computeVertexNormals();
             return geometry;
        }

        // --- Instanced Mesh Setup ---

        /**
         * Creates and populates an InstancedMesh for a given detail type.
         * @param {THREE.BufferGeometry} baseGeometry - The geometry to instance.
         * @param {THREE.Material} material - The material to use.
         * @param {number} count - Number of instances.
         * @param {THREE.Mesh} floor - The floor mesh to cast rays against.
         * @param {number} placementRadius - Radius around origin to place instances.
         * @param {number} minScale - Minimum random scale.
         * @param {number} maxScale - Maximum random scale.
         */
        function createDetailInstances(baseGeometry, material, count, floor, placementRadius = 50, minScale = 0.5, maxScale = 1.5) {
            if (!floor) return null;

            const mesh = new THREE.InstancedMesh(baseGeometry, material, count);
            mesh.castShadow = true;
            mesh.receiveShadow = true; // Receive shadows from other objects

            const dummy = new THREE.Object3D(); // Used for matrix calculation
            let instancesPlaced = 0;
            const attempts = count * 5; // Try more times than needed to ensure coverage
            const placedPositions = []; // Simple check to avoid overcrowding

            for (let i = 0; i < attempts && instancesPlaced < count; i++) {
                // Find random position on floor
                const x = (Math.random() - 0.5) * placementRadius * 2;
                const z = (Math.random() - 0.5) * placementRadius * 2;
                raycaster.set(new THREE.Vector3(x, 30, z), DOWN_VECTOR); // Raycast from above
                const intersects = raycaster.intersectObject(floor);

                if (intersects.length > 0) {
                    const point = intersects[0].point;
                    const normal = intersects[0].face.normal.clone().normalize();
                    
                    // Simple check to avoid placing items too close together
                    let tooClose = false;
                    for(const p of placedPositions) {
                         if(p.distanceToSquared(point) < 0.1) { // Minimum distance squared
                              tooClose = true; break;
                         }
                    }
                    if(tooClose) continue;

                    // Set position
                    dummy.position.copy(point);
                    dummy.position.addScaledVector(normal, 0.01); // Lift slightly off surface

                    // Set rotation to align with normal and add random yaw
                    dummy.quaternion.setFromUnitVectors(UP_VECTOR, normal);
                    dummy.rotateY(Math.random() * Math.PI * 2);
                    
                    // Set random scale
                    const scale = THREE.MathUtils.lerp(minScale, maxScale, Math.random());
                    dummy.scale.set(scale, scale, scale);

                    // Update matrix and set instance
                    dummy.updateMatrix();
                    mesh.setMatrixAt(instancesPlaced, dummy.matrix);
                    
                    placedPositions.push(point.clone()); // Record position
                    instancesPlaced++;
                }
            }
            
            console.log(`Placed ${instancesPlaced}/${count} instances of ${baseGeometry.type}`);
            mesh.count = instancesPlaced; // Important: Set count to actual placed instances
            mesh.instanceMatrix.needsUpdate = true;

            return mesh;
        }

        // --- Caustic Effect (Copied) ---
        function createCausticTexture(size = 256) { /* ... */ causticCanvas=document.getElementById('dynamicTextureCanvas'); if(!causticCanvas){causticCanvas=document.createElement('canvas');} causticCanvas.width=size; causticCanvas.height=size; causticCtx=causticCanvas.getContext('2d'); const t=new THREE.CanvasTexture(causticCanvas); t.wrapS=t.wrapT=THREE.RepeatWrapping; t.minFilter=THREE.LinearFilter; return t; }
        function updateCausticTexture(texture, time) { /* ... */ const s=texture.image.width; const c=causticCtx; c.fillStyle='rgb(15,15,25)'; c.fillRect(0,0,s,s); const l=4; for(let i=0;i<l;i++){ c.strokeStyle=`rgba(${180+Math.random()*50},${210+Math.random()*45},255,${.05+Math.random()*.05})`; c.lineWidth=Math.random()*1.5+1.; c.beginPath(); const f=(i+1)*.04+.03; const a=s*.18; const sp=(i+1)*.25+.15; const ox=Math.sin(time*sp*.6+i*2.)*s*.25; const oy=Math.cos(time*sp*.45+i*3.)*s*.25; for(let x=0;x<s;x++){ const y=Math.sin((x+ox)*f+time*sp+Math.cos(x*.03)*.5)*a+s/2+oy+Math.cos(x*.04+time*.15+i*1.5)*15; if(x===0)c.moveTo(x,y); else c.lineTo(x,y); } c.stroke(); } texture.needsUpdate=true; }

        // --- Initialization ---
        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x3498DB); 
            scene.fog = new THREE.Fog(0x3498DB, 20, 60); 

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 150); 
            camera.position.set(0, 3, 10); 

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            renderer.toneMapping = THREE.ACESFilmicToneMapping; 
            renderer.outputEncoding = THREE.sRGBEncoding; 
            renderer.shadowMap.enabled = true; 
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            document.body.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0x80B0FF, 0.5); 
            scene.add(ambientLight);
            const directionalLight = new THREE.DirectionalLight(0xFFF5E0, 1.0); 
            directionalLight.position.set(15, 25, 20);
            directionalLight.castShadow = true; 
            directionalLight.shadow.camera.near = 1; directionalLight.shadow.camera.far = 80;
            directionalLight.shadow.camera.left = -30; directionalLight.shadow.camera.right = 30; 
            directionalLight.shadow.camera.top = 30; directionalLight.shadow.camera.bottom = -30;
            directionalLight.shadow.mapSize.width = 1024; directionalLight.shadow.mapSize.height = 1024;
            directionalLight.shadow.bias = -0.002; 
            scene.add(directionalLight);
            
            // Caustic Setup
            causticTexture = createCausticTexture(256); 

            // Controls
            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.target.set(0, 0, 0); 

            // --- Create Floor ---
            const floorMaterial = new THREE.ShaderMaterial({
                vertexShader: floorVertexShader, fragmentShader: floorFragmentShader,
                uniforms: { uTime: { value: 0.0 }, uSandColor: { value: new THREE.Color(0xD2B48C) }, uRockColor: { value: new THREE.Color(0x607080) }, uWetSandColor: { value: new THREE.Color(0xA08C6E) }, uCausticMap: { value: causticTexture } }
            });
            floorMesh = new THREE.Mesh( new THREE.PlaneGeometry(120, 120, 150, 150), floorMaterial);
            const positions = floorMesh.geometry.attributes.position; const vertex = new THREE.Vector3();
            for (let i=0; i<positions.count; i++) { vertex.fromBufferAttribute(positions,i); let p2=new THREE.Vector2(vertex.x*.03,vertex.z*.03); let h=fbm(p2,5,.55)*3.5; positions.setY(i,h); }
            floorMesh.geometry.computeVertexNormals(); positions.needsUpdate=true;
            floorMesh.rotation.x=-Math.PI/2; floorMesh.position.y=-5; floorMesh.receiveShadow=true;
            scene.add(floorMesh);


            // --- Create Detail Instances ---
            // Clone floor material for details - allows potential future variation
            const detailMaterial = floorMaterial.clone(); 
            
            const pebbleGeo = createPebbleGeometry(0.1, 0);
            const conicalShellGeo = createConicalShellGeometry(0.08, 0.25, 6);
            const spiralShellGeo = createSpiralShellGeometry(0.15, 3, 12);

            const pebbleInstances = createDetailInstances(pebbleGeo, detailMaterial, 500, floorMesh, 50, 0.7, 1.3);
            const conicalInstances = createDetailInstances(conicalShellGeo, detailMaterial, 150, floorMesh, 50, 0.8, 1.2);
            const spiralInstances = createDetailInstances(spiralShellGeo, detailMaterial, 100, floorMesh, 50, 0.9, 1.1);

            if(pebbleInstances) detailMeshesGroup.add(pebbleInstances);
            if(conicalInstances) detailMeshesGroup.add(conicalInstances);
            if(spiralInstances) detailMeshesGroup.add(spiralInstances);
            
            scene.add(detailMeshesGroup);


            window.addEventListener('resize', onWindowResize);
        }
        
        // --- Resize Handler ---
        function onWindowResize() { /* ... */ camera.aspect=window.innerWidth/window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth,window.innerHeight); }

        // --- Animation Loop ---
        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();
            const deltaTime = clock.getDelta();

            if (causticTexture) { updateCausticTexture(causticTexture, elapsedTime); }

            // Update time uniform for floor and detail materials
            if (floorMesh?.material?.uniforms?.uTime) floorMesh.material.uniforms.uTime.value = elapsedTime;
             detailMeshesGroup.children.forEach(instancedMesh => {
                if (instancedMesh.material?.uniforms?.uTime) {
                    instancedMesh.material.uniforms.uTime.value = elapsedTime;
                }
             });
            
            controls.update(); 
            renderer.render(scene, camera);
        }

        init();
        animate();

    </script>
</body>
</html>