<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Procedural Pufferfish Obstacle</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #3498DB; }
        canvas { display: block; }
         #info { position: absolute; top: 10px; width: 100%; text-align: center; color: white; font-family: sans-serif; z-index: 10; }
    </style>
</head>
<body>
     <div id="info">Approach the Pufferfish!</div>
    <!-- No extra canvas needed -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.module.min.js",
          "three/addons/": "https://unpkg.com/three@0.134.0/examples/jsm/"
        }
      }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { SimplexNoise } from 'three/addons/math/SimplexNoise.js';

        let scene, camera, renderer, controls;
        let pufferfishArray = [];
        let playerSphere; // Simple sphere to represent player for collision check
        const clock = new THREE.Clock();
        const simplex = new SimplexNoise();

        // --- Noise Functions (Copied) ---
        function hash(p){/*...*/} function noise(p){/*...*/} function fbm(p,o=3,pe=0.5){/*...*/}

        // --- Pufferfish Shaders ---

        const pufferVertexShader = `
            varying vec3 vNormal;
            varying vec3 vWorldPosition;
            varying vec2 vUv;

            uniform float uTime;
            uniform float uInflationFactor; // 0.0 = deflated, 1.0 = inflated
            uniform float uMaxInflationAmount; // How much the radius increases

            attribute vec3 aSpikeBase; // Base position on sphere for spike origin
            attribute vec3 aSpikeNormal; // Normal at spike base

            // Simplex noise 3D function (if needed for more complex deformation)
            // vec3 snoiseVec3( vec3 x ){ ... } 

            void main() {
                vUv = uv;
                vec3 pos = position;
                vec3 baseNormal = normal; // Store original normal

                // --- Inflation Deformation ---
                // Simple radial expansion based on inflation factor
                float inflation = uInflationFactor * uMaxInflationAmount;
                // Displace vertex along its normal
                pos += normal * inflation; 
                
                // Optional: Add subtle wobble/pulsation even when inflated/deflated
                 float wobbleFreq = 3.0;
                 float wobbleAmp = 0.02 * (1.0 + uInflationFactor); // Slightly more wobble when inflated
                 float wobble = sin(uTime * wobbleFreq + position.y * 2.0) * wobbleAmp;
                 pos += normal * wobble;


                // --- Final Position & Normal ---
                vec4 worldPos = modelMatrix * vec4(pos, 1.0);
                vWorldPosition = worldPos.xyz;
                
                // Recompute normal visually (doesn't affect lighting calc directly here)
                 vNormal = normalize( normalMatrix * baseNormal ); // Use base normal for lighting consistency

                gl_Position = projectionMatrix * viewMatrix * worldPos;
            }
        `;

        const pufferFragmentShader = `
            varying vec3 vNormal;
            varying vec3 vWorldPosition;
            varying vec2 vUv;

            uniform float uTime;
            uniform float uInflationFactor;
            uniform vec3 uColorBody;
            uniform vec3 uColorSpots;

            // Noise functions redeclared
            float hashFS(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);} 
            float noiseFS(vec2 p){vec2 i=floor(p); vec2 f=fract(p); f=f*f*(3.-2.*f); float a=hashFS(i+vec2(0,0)); float b=hashFS(i+vec2(1,0)); float c=hashFS(i+vec2(0,1)); float d=hashFS(i+vec2(1,1)); return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);}
            float fbmFS(vec2 p,int o,float pe){float v=0.; float a=1.; float f=1.; float mv=0.; for(int i=0;i<o;i++){v+=noiseFS(p*f)*a; mv+=a; a*=pe; f*=2.;} return v/mv;}

            void main() {
                vec3 normal = normalize(vNormal);

                // --- Spot Pattern (Cellular/Voronoi-like noise) ---
                vec2 pos = vWorldPosition.xz * (1.5 + uInflationFactor * 0.5); // Pattern stretches slightly when inflated
                float spots = fbmFS(pos, 4, 0.5); // Use FBM for variation
                // Create sharper spots using smoothstep
                spots = smoothstep(0.4, 0.45, spots) - smoothstep(0.6, 0.65, spots); 
                
                // --- Base Color ---
                vec3 baseColor = mix(uColorBody, uColorSpots, spots * 0.8); // Mix body color with spot color

                 // Add subtle color variation based on inflation (paler when stretched?)
                 baseColor = mix(baseColor, baseColor * 1.1 + vec3(0.05), uInflationFactor * 0.3);

                // --- Lighting ---
                vec3 viewDir = normalize(cameraPosition - vWorldPosition);
                vec3 lightDir = normalize(vec3(0.5, 0.8, 0.6));
                float diff = max(dot(normal, lightDir), 0.0);
                vec3 halfwayDir = normalize(lightDir + viewDir);
                float specAngle = max(dot(normal, halfwayDir), 0.0);
                float spec = pow(specAngle, 12.0) * 0.3; // Relatively soft specular
                vec3 litColor = baseColor * (diff * 0.7 + 0.3) + vec3(spec);

                // --- Final Color ---
                gl_FragColor = vec4(litColor, 1.0); // Opaque
                 gl_FragColor.rgb = pow(gl_FragColor.rgb, vec3(1.0/2.2)); 
            }
        `;
        
        // Simple shader for the spikes
         const spikeFragmentShader = `
            uniform vec3 uColor;
            void main() {
                gl_FragColor = vec4(uColor, 1.0);
                 gl_FragColor.rgb = pow(gl_FragColor.rgb, vec3(1.0/2.2)); 
            }
         `;
          const spikeVertexShader = `
             uniform float uInflationFactor; // Control spike scale/visibility
             uniform float uBaseScale; // Base size of the spike mesh

             void main() {
                // Scale spike based on inflation factor
                 float scale = uBaseScale * uInflationFactor; // Simple linear scale
                 // Alternatively, could use smoothstep for faster appear/disappear
                 // float scale = uBaseScale * smoothstep(0.1, 0.3, uInflationFactor); 

                 // If scale is near zero, collapse vertex to hide it efficiently
                 if (scale < 0.01) {
                      gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
                      return;
                 }

                vec3 scaledPos = position * scale; // Apply scale

                // Position spike at its base location and rotate it along its normal
                // (This requires instance attributes: aSpikeBase, aSpikeNormal)
                // vec4 worldPos = instanceMatrix * vec4(scaledPos, 1.0); 
                
                // Simpler: Assume spike mesh is added as child and positioned/rotated in JS
                 gl_Position = projectionMatrix * modelViewMatrix * vec4(scaledPos, 1.0);
             }
          `;

        // --- Pufferfish Geometry & Material ---
        function createPufferfishBodyGeometry(radius = 0.6, detail = 2) {
            // Use Icosahedron for more even vertex distribution than Sphere
            const geometry = new THREE.IcosahedronGeometry(radius, detail);
            // Could add slight initial deformation here if desired
            return geometry;
        }

        function createPufferfishMaterial(isSpike = false) {
             if (isSpike) {
                  return new THREE.ShaderMaterial({
                      vertexShader: spikeVertexShader,
                      fragmentShader: spikeFragmentShader,
                      uniforms: {
                          uInflationFactor: { value: 0.0 },
                          uBaseScale: { value: 0.15 + Math.random() * 0.1 }, // Randomize spike size slightly
                          uColor: { value: new THREE.Color(0x443322) } // Dark brown/black spikes
                      }
                  });
             } else {
                  return new THREE.ShaderMaterial({
                     vertexShader: pufferVertexShader,
                     fragmentShader: pufferFragmentShader,
                     uniforms: {
                         uTime: { value: 0.0 },
                         uInflationFactor: { value: 0.0 },
                         uMaxInflationAmount: { value: 0.8 + Math.random() * 0.4 }, // How much radius increases
                         uColorBody: { value: new THREE.Color(0xF5F5DC) }, // Beige
                         uColorSpots: { value: new THREE.Color(0x8B4513) } // SaddleBrown spots
                     }
                 });
             }
        }

        function createSpikeGeometry(length = 1.0, radius = 0.1) {
            // Simple cone for spikes
            const geometry = new THREE.ConeGeometry(radius, length, 6, 1); // Radius, Height, Segments
            geometry.translate(0, length * 0.5, 0); // Position base at origin
            geometry.rotateX(Math.PI); // Point outward (down Y axis which becomes outward normal)
            return geometry;
        }

        // --- Pufferfish Assembly ---
        function createPufferfish(options = {}) {
             const {
                scale = 0.8 + Math.random() * 0.4,
                triggerRadius = scale * 2.5, // Radius at which it starts inflating
                numSpikes = 50 + Math.floor(Math.random() * 30)
            } = options;

            const group = new THREE.Group();
            group.scale.set(scale, scale, scale);

            // Create Body
            const bodyRadius = 0.6; // Base radius before scaling
            const bodyGeometry = createPufferfishBodyGeometry(bodyRadius);
            const bodyMaterial = createPufferfishMaterial(false);
            const bodyMesh = new THREE.Mesh(bodyGeometry, bodyMaterial);
            bodyMesh.castShadow = true; bodyMesh.receiveShadow = true;
            group.add(bodyMesh);
            group.userData.bodyMaterial = bodyMaterial; // Store for uniform updates

            // Create Spikes (Using individual meshes attached to body - simpler than InstancedMesh for this)
            const spikeGeometry = createSpikeGeometry(0.2, 0.015); // Base spike shape
            const spikeMaterial = createPufferfishMaterial(true);
            const spikes = []; // Array to hold spike meshes

            const positions = bodyGeometry.attributes.position;
            const normals = bodyGeometry.attributes.normal;
            const up = new THREE.Vector3(0, 1, 0);

             // Distribute spikes somewhat evenly using geometry vertices
             const step = Math.max(1, Math.floor(positions.count / numSpikes));
             for(let i=0; i < positions.count; i += step) {
                  const spike = new THREE.Mesh(spikeGeometry, spikeMaterial.clone()); // Clone material for unique uniforms

                  const basePos = new THREE.Vector3().fromBufferAttribute(positions, i);
                  const baseNormal = new THREE.Vector3().fromBufferAttribute(normals, i).normalize();

                  spike.position.copy(basePos); // Position spike at vertex
                  spike.quaternion.setFromUnitVectors(up, baseNormal); // Align spike to normal
                  
                  // Initial scale is 0 via shader uniform uInflationFactor
                  
                  bodyMesh.add(spike); // Add as child of body for easier transform
                  spikes.push(spike);
             }
             group.userData.spikes = spikes; // Store spike meshes


            // Create Fins (Simple shapes)
            const finShape = new THREE.Shape(); finShape.moveTo(0,0); finShape.lineTo(0.15, 0.1); finShape.lineTo(0, 0.2); finShape.lineTo(-0.15, 0.1); finShape.lineTo(0,0);
            const finExtrude = {depth: 0.02, bevelEnabled: false};
            const finGeo = new THREE.ExtrudeGeometry(finShape, finExtrude); finGeo.center();
            const finMat = new THREE.MeshStandardMaterial({color: 0xD2B48C, roughness: 0.6}); // Simple material

            const leftFin = new THREE.Mesh(finGeo, finMat); leftFin.scale.set(0.5,0.5,0.5); leftFin.position.set(-bodyRadius*0.8, -0.1, 0.1); leftFin.rotation.z = -0.5; bodyMesh.add(leftFin);
            const rightFin = new THREE.Mesh(finGeo, finMat); rightFin.scale.set(0.5,0.5,0.5); rightFin.position.set(bodyRadius*0.8, -0.1, 0.1); rightFin.rotation.z = 0.5; bodyMesh.add(rightFin);
            const tailFin = new THREE.Mesh(finGeo, finMat); tailFin.scale.set(0.4,0.6,0.4); tailFin.position.set(0, -0.05, -bodyRadius*0.9); tailFin.rotation.x = Math.PI/2; bodyMesh.add(tailFin);

            // Eyes
            const eyeGeo = new THREE.SphereGeometry(0.08, 12, 8);
            const eyeMat = new THREE.MeshStandardMaterial({color: 0x111111});
            const leftEye = new THREE.Mesh(eyeGeo, eyeMat); leftEye.position.set(-0.25, 0.15, bodyRadius*0.7); bodyMesh.add(leftEye);
            const rightEye = new THREE.Mesh(eyeGeo, eyeMat); rightEye.position.set(0.25, 0.15, bodyRadius*0.7); bodyMesh.add(rightEye);


            // State Management Data
            group.userData.state = 'IDLE'; // IDLE, INFLATING, INFLATED, DEFLATING
            group.userData.triggerRadiusSq = triggerRadius * triggerRadius; // Store squared radius for efficiency
            group.userData.inflationTimer = 0;
            group.userData.inflationDuration = 0.25; // Time to inflate fully
            group.userData.deflationDuration = 1.0; // Time to deflate fully
            group.userData.inflatedHoldDuration = 1.5; // Time to stay inflated
            group.userData.cooldownTimer = 0;
            group.userData.cooldownDuration = 1.0; // Time before it can inflate again
            group.userData.baseScale = scale; // Store original scale

            group.userData.update = updatePufferfish; // Assign update function

            return group;
        }

        // --- Pufferfish Update Logic ---
        function updatePufferfish(time, deltaTime, playerPos) {
            // 'this' refers to the pufferfish group
            const data = this.userData;
            const bodyMat = data.bodyMaterial;
            
            // Update shader time uniform (for wobble)
             if (bodyMat?.uniforms?.uTime) {
                bodyMat.uniforms.uTime.value = time;
             }

            // --- State Transitions ---
            const distSq = this.position.distanceToSquared(playerPos);
            
            // Cooldown logic
            if(data.cooldownTimer > 0) {
                 data.cooldownTimer -= deltaTime;
                 if(data.cooldownTimer <= 0 && data.state !== 'IDLE') { // Force back to idle after cooldown if needed
                      data.state = 'DEFLATING'; // Start deflation if not already idle
                      data.inflationTimer = data.deflationDuration; // Start timer from max deflation time
                 }
                 // Cannot inflate during cooldown
            } 
            // Trigger inflation only if IDLE and player is close and not in cooldown
            else if (data.state === 'IDLE' && distSq < data.triggerRadiusSq) {
                data.state = 'INFLATING';
                data.inflationTimer = 0;
                // audioManager.playSound('puffer_inflate'); // Play sound
                console.log("Pufferfish inflating!");
            }

            // --- State Actions ---
            let inflationFactor = bodyMat?.uniforms?.uInflationFactor?.value ?? 0;

            switch(data.state) {
                case 'INFLATING':
                    data.inflationTimer += deltaTime;
                    inflationFactor = Math.min(1.0, data.inflationTimer / data.inflationDuration);
                    // Smoothstep for ease-in/out? inflationFactor = smoothstep(0.0, 1.0, inflationFactor);
                    if (data.inflationTimer >= data.inflationDuration) {
                        inflationFactor = 1.0;
                        data.state = 'INFLATED';
                        data.inflationTimer = 0; // Reset timer for hold duration
                    }
                    break;
                
                case 'INFLATED':
                    data.inflationTimer += deltaTime;
                     // Optional: Add slight visual pulse while inflated
                     const pulse = Math.sin(time * 5.0) * 0.05 + 1.0; // 0.95 to 1.05
                     inflationFactor = pulse; // Set factor to pulsing value around 1.0

                    if (data.inflationTimer >= data.inflatedHoldDuration) {
                        data.state = 'DEFLATING';
                        data.inflationTimer = 0; // Reset timer for deflation
                         // audioManager.playSound('puffer_deflate');
                    }
                    break;

                 case 'DEFLATING':
                    data.inflationTimer += deltaTime;
                    inflationFactor = Math.max(0.0, 1.0 - (data.inflationTimer / data.deflationDuration));
                    // Ease out deflation: inflationFactor = 1.0 - smoothstep(0.0, 1.0, data.inflationTimer / data.deflationDuration);
                    if (data.inflationTimer >= data.deflationDuration) {
                        inflationFactor = 0.0;
                        data.state = 'IDLE';
                        data.inflationTimer = 0;
                         data.cooldownTimer = data.cooldownDuration; // Start cooldown
                         console.log("Pufferfish deflated, cooldown started.");
                    }
                    break;
                
                case 'IDLE':
                    // Do nothing special
                    inflationFactor = 0.0; // Ensure it's fully deflated
                    break;
            }

            // --- Update Uniforms ---
             if (bodyMat?.uniforms?.uInflationFactor) {
                bodyMat.uniforms.uInflationFactor.value = inflationFactor;
             }
             // Update spike materials
             data.spikes.forEach(spike => {
                 if(spike.material?.uniforms?.uInflationFactor) {
                     spike.material.uniforms.uInflationFactor.value = inflationFactor;
                 }
             });
             
            // Collision Logic Placeholder:
            // The effective collision radius changes based on inflationFactor
            // const currentRadius = data.baseScale * (bodyRadius + bodyMat.uniforms.uMaxInflationAmount.value * inflationFactor);
            // Check collision between player and this currentRadius...
        }


        // --- Initialization ---
        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x3498DB); 
            scene.fog = new THREE.Fog(0x3498DB, 15, 50); 

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100); 
            camera.position.set(0, 3, 10); 

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            renderer.toneMapping = THREE.ACESFilmicToneMapping; 
            renderer.outputEncoding = THREE.sRGBEncoding; 
            renderer.shadowMap.enabled = true; 
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            document.body.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0x90B0FF, 0.6); 
            scene.add(ambientLight);
            const directionalLight = new THREE.DirectionalLight(0xFFFFFF, 0.9); 
            directionalLight.position.set(8, 12, 10);
            directionalLight.castShadow = true; 
             directionalLight.shadow.mapSize.width = 1024; directionalLight.shadow.mapSize.height = 1024;
            scene.add(directionalLight);

            // Controls
            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.target.set(0, 0.5, 0); 

            // Create Example Pufferfish
             for (let i = 0; i < 3; i++) {
                const puffer = createPufferfish({ scale: 1.0 + Math.random() * 0.5 });
                if (puffer) {
                     puffer.position.set(
                         (Math.random() - 0.5) * 10,
                         0.5, 
                         (Math.random() - 0.5) * 8 - 4
                     );
                    scene.add(puffer);
                    pufferfishArray.push(puffer);
                }
            }

            // Simple Player Representation (Sphere)
            const playerGeo = new THREE.SphereGeometry(0.3, 16, 12);
            const playerMat = new THREE.MeshStandardMaterial({color: 0xff0000});
            playerSphere = new THREE.Mesh(playerGeo, playerMat);
            playerSphere.position.set(0, 0.5, 5); // Start in front
            scene.add(playerSphere);

            // Optional floor
             const floorGeo = new THREE.PlaneGeometry(30,30); const floorMat = new THREE.MeshStandardMaterial({color: 0x806040, roughness: 0.8}); const floor = new THREE.Mesh(floorGeo, floorMat); floor.rotation.x = -Math.PI/2; floor.position.y = -0.1; floor.receiveShadow = true; scene.add(floor);

            window.addEventListener('resize', onWindowResize);
        }
        
        // --- Resize Handler ---
        function onWindowResize() { /* ... */ camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight); }

        // --- Animation Loop ---
        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();
            const deltaTime = clock.getDelta();

             // Simple player movement towards pufferfish for demo
             if (playerSphere.position.z > -5) {
                  playerSphere.position.z -= 2.0 * deltaTime;
             } else {
                 playerSphere.position.z = 5; // Reset
             }


            // Update Pufferfish
            pufferfishArray.forEach(puffer => {
                if (puffer.userData.update) {
                     puffer.userData.update(elapsedTime, deltaTime, playerSphere.position);
                }
            });
            
            controls.update(); 
            renderer.render(scene, camera);
        }

        init();
        animate();

    </script>
</body>
</html>