<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Refined Procedural Bubbles Character v2</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #3498DB; /* Lighter blue background */ }
        canvas { display: block; }
    </style>
</head>
<body>
    <!-- Canvas for potential procedural texture (if needed later, e.g., caustics) -->
    <canvas id="dynamicTextureCanvas" style="display:none;"></canvas> 

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.module.min.js",
          "three/addons/": "https://unpkg.com/three@0.134.0/examples/jsm/"
        }
      }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { SimplexNoise } from 'three/addons/math/SimplexNoise.js';

        let scene, camera, renderer, controls;
        let bubblesCharacter;
        const clock = new THREE.Clock();
        const simplex = new THREE.SimplexNoise(); // Use the imported one

        // --- Shader Definitions ---

        const bubblesVertexShader = `
            varying vec3 vNormal;
            varying vec3 vViewPosition;
            varying vec3 vObjectPosition;
            varying vec2 vUv; // Pass UV 

            void main() {
                vUv = uv; // Pass UV coordinates
                vNormal = normalize(normalMatrix * normal); // Transform normal to view space
                vObjectPosition = position; // Pass object space position for pattern calculation

                vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                vViewPosition = -mvPosition.xyz; // Vector from vertex to camera in view space
                gl_Position = projectionMatrix * mvPosition; // Final position in clip space
            }
        `;

        const bubblesFragmentShader = `
            uniform vec3 uBaseColor;      // Base orange
            uniform vec3 uStripeColor;    // White stripes
            uniform vec3 uBorderColor;    // Dark border color
            uniform float uTime;          // Time for potential animation
            uniform float uNoiseFactor;   // Intensity of surface noise
            uniform float uIsFinOrTail;   // Flag: 0.0 for body, 1.0 for fin/tail

            varying vec3 vNormal;         // Interpolated normal in view space
            varying vec3 vViewPosition;   // Interpolated view position
            varying vec3 vObjectPosition; // Interpolated object position
            varying vec2 vUv;             // Interpolated UV coordinates

            // --- Noise Functions ---
            // Simple hash function
            float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
            // Basic noise value
            float noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                f = f*f*(3.0-2.0*f); // Smoothstep interpolation (Hermite curve)
                float a = hash(i + vec2(0.0, 0.0)); float b = hash(i + vec2(1.0, 0.0));
                float c = hash(i + vec2(0.0, 1.0)); float d = hash(i + vec2(1.0, 1.0));
                return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
            }
            // Fractal Brownian Motion (FBM) - Layered noise for more detail
            float fbm(vec2 p, int octaves, float persistence) {
                float total = 0.0;
                float frequency = 1.0;
                float amplitude = 1.0;
                float maxValue = 0.0; // Used for normalizing result to 0.0 - 1.0
                for(int i = 0; i < octaves; i++) {
                    total += noise(p * frequency) * amplitude;
                    maxValue += amplitude;
                    amplitude *= persistence; // Amplitude decreases with each octave
                    frequency *= 2.0;       // Frequency increases with each octave
                }
                return total / maxValue;
            }

            // --- Lighting Function ---
            // Slightly more nuanced Phong/Blinn-Phong style lighting
            vec3 calculateLighting(vec3 normal, vec3 viewDir, vec3 lightDir, vec3 lightColor, vec3 objectColor) {
                // Diffuse
                float diff = max(dot(normal, lightDir), 0.0);
                vec3 diffuse = diff * lightColor;

                // Specular (Blinn-Phong halfway vector)
                vec3 halfwayDir = normalize(lightDir + viewDir);
                float specAngle = max(dot(normal, halfwayDir), 0.0);
                // Control shininess with specularPower - lower is softer/wider
                float specularPower = 20.0; 
                float spec = pow(specAngle, specularPower);
                // Control intensity and color of specular highlights
                vec3 specular = spec * lightColor * 0.6; 

                // Combine lighting components
                return (diffuse * 0.7 + specular) * objectColor; // Adjust mix as needed
            }

            // --- Smooth Transition Function ---
            float smoothstep(float edge0, float edge1, float x) {
                float t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
                return t * t * (3.0 - 2.0 * t);
            }

            void main() {
                vec3 normal = normalize(vNormal);       // Normalize interpolated normal
                vec3 viewDir = normalize(vViewPosition); // Normalize view direction
                vec3 finalColor;                         // Final output color

                // --- Surface Noise Calculation ---
                // Calculate FBM noise based on object position and time for subtle variation
                // Use 3 octaves for some detail, persistence < 0.5 makes higher freqs less impactful
                float surfaceNoise = fbm(vObjectPosition.xy * 4.0 + uTime * 0.05, 3, 0.4); 
                // Apply noise subtly to the base color brightness
                vec3 baseWithNoise = uBaseColor * (1.0 + (surfaceNoise - 0.5) * uNoiseFactor);

                // --- Stripe / Fin Tip Calculation ---
                if (uIsFinOrTail < 0.5) { // == 0.0: Body logic
                    float zPos = vObjectPosition.z;       // Z position along the fish body
                    float bodyLength = 1.2 * 2.0;         // Approximate length from scaling
                    float normZ = (zPos / (bodyLength * 0.5)); // Normalize Z roughly to -1 to 1

                    // Stripe definitions (centers and widths in normalized Z space)
                    float stripe1_center = 0.6; float stripe1_width = 0.14; // Slightly thinner stripes
                    float stripe2_center = 0.0; float stripe2_width = 0.14;
                    float stripe3_center = -0.6; float stripe3_width = 0.14;
                    float border_width = 0.04;            // Width of the dark border
                    float softness = 0.035;               // Increased softness for transitions

                    // Calculate stripe alpha using smoothstep for soft edges
                    float stripe1 = smoothstep(stripe1_center - stripe1_width, stripe1_center - stripe1_width + softness, normZ) -
                                    smoothstep(stripe1_center + stripe1_width - softness, stripe1_center + stripe1_width, normZ);
                    float stripe2 = smoothstep(stripe2_center - stripe2_width, stripe2_center - stripe2_width + softness, normZ) -
                                    smoothstep(stripe2_center + stripe2_width - softness, stripe2_center + stripe2_width, normZ);
                    float stripe3 = smoothstep(stripe3_center - stripe3_width, stripe3_center - stripe3_width + softness, normZ) -
                                    smoothstep(stripe3_center + stripe3_width - softness, stripe3_center + stripe3_width, normZ);

                    // Calculate border alpha (slightly wider area)
                    float border1 = smoothstep(stripe1_center - stripe1_width - border_width, stripe1_center - stripe1_width - border_width + softness, normZ) -
                                    smoothstep(stripe1_center + stripe1_width + border_width - softness, stripe1_center + stripe1_width + border_width, normZ);
                    float border2 = smoothstep(stripe2_center - stripe2_width - border_width, stripe2_center - stripe2_width - border_width + softness, normZ) -
                                    smoothstep(stripe2_center + stripe2_width + border_width - softness, stripe2_center + stripe2_width + border_width, normZ);
                    float border3 = smoothstep(stripe3_center - stripe3_width - border_width, stripe3_center - stripe3_width - border_width + softness, normZ) -
                                    smoothstep(stripe3_center + stripe3_width + border_width - softness, stripe3_center + stripe3_width + border_width, normZ);

                    // Combine alphas: Border alpha is the border area *minus* the stripe area
                    float borders = max(border1 - stripe1, 0.0) + max(border2 - stripe2, 0.0) + max(border3 - stripe3, 0.0);
                    borders = clamp(borders, 0.0, 1.0);
                    // Combined stripe alpha
                    float stripes = max(stripe1, max(stripe2, stripe3));
                    stripes = clamp(stripes, 0.0, 1.0);

                    // Mix colors based on alphas: Start with noisy base, add stripes, then borders
                    finalColor = mix(baseWithNoise, uStripeColor, stripes);
                    finalColor = mix(finalColor, uBorderColor, borders);

                } else { // == 1.0: Fin / Tail logic
                    // Darken the tip based on UV coordinate (assuming V=1 at tip)
                    float tipGradient = smoothstep(0.70, 0.90, vUv.y); // Adjust gradient range
                    // Mix between the noisy base color and the border color
                    finalColor = mix(baseWithNoise, uBorderColor, tipGradient);
                }

                // --- Apply Lighting ---
                vec3 lightDir1 = normalize(vec3(1.0, 1.5, 0.8)); // Adjust main light direction
                vec3 lightColor1 = vec3(1.0, 1.0, 0.95);       // Slightly warmer light
                vec3 lighting = calculateLighting(normal, viewDir, lightDir1, lightColor1, finalColor);

                // Ambient light contribution
                vec3 ambientLight = vec3(0.45) * finalColor; // Adjust ambient intensity

                // --- Rim Light (Fresnel effect) ---
                float rimDot = 1.0 - dot(viewDir, normal); // Amount facing away from camera
                // Control rim sharpness and brightness
                float rimAmount = smoothstep(0.15, 0.6, rimDot); // Adjust falloff range
                // Rim color based on base orange, slightly brighter/warmer
                vec3 rimColor = uBaseColor * 1.2 * rimAmount * 0.7; 

                // --- Final Combination ---
                gl_FragColor = vec4(ambientLight + lighting + rimColor, 1.0);
            }
        `;

        // --- Geometry Creation Functions ---
        // Body: Uses noise displacement on a sphere, then scales
        function createBubblesBodyGeometry() {
            const baseGeometry = new THREE.SphereGeometry(1, 32, 24); 
            const positions = baseGeometry.attributes.position;
            const normals = baseGeometry.attributes.normal;
            const vertex = new THREE.Vector3();
            const normal = new THREE.Vector3();
            const noiseFrequency = 1.9; // Slightly adjusted frequency
            const noiseAmplitude = 0.03; // Keep noise subtle

            for (let i = 0; i < positions.count; i++) {
                vertex.fromBufferAttribute(positions, i);
                normal.fromBufferAttribute(normals, i);
                const noise = simplex.noise3D(vertex.x * noiseFrequency, vertex.y * noiseFrequency, vertex.z * noiseFrequency);
                vertex.addScaledVector(normal, noise * noiseAmplitude);
                positions.setXYZ(i, vertex.x, vertex.y, vertex.z);
            }
            // Apply overall scaling after noise displacement
            baseGeometry.scale(0.8, 0.6, 1.2); 
            baseGeometry.computeVertexNormals(); 
            baseGeometry.attributes.position.needsUpdate = true;
            return baseGeometry;
        }

        // Pectoral Fins (Side fins): Extruded custom shape with bevel
        function createPectoralFinGeometry() {
            const finShape = new THREE.Shape();
            // Define 2D shape (adjust curves for desired look)
            finShape.moveTo(0, 0);
            finShape.quadraticCurveTo(0.4, 0.2, 0.5, 0.8); 
            finShape.quadraticCurveTo(0.3, 0.9, 0.1, 1.0); 
            finShape.quadraticCurveTo(-0.1, 0.8, 0, 0);    
            
            // Extrude settings with bevel for softer edges
            const extrudeSettings = { depth: 0.05, bevelEnabled: true, bevelSize: 0.015, bevelSegments: 2 }; 
            const geometry = new THREE.ExtrudeGeometry(finShape, extrudeSettings);
            geometry.center(); // Center for easier rotation
            geometry.rotateX(Math.PI / 2); // Orient flat along XY plane initially
            geometry.scale(0.8, 0.8, 0.8); // Adjust overall size
            geometry.computeVertexNormals();
            // Note: ExtrudeGeometry UVs might need manual adjustment for perfect tip gradient
            return geometry;
        }

        // Tail Fin (Caudal): Extruded custom shape with bevel
        function createTailGeometry() {
             const tailShape = new THREE.Shape();
             // Define 2D shape (adjust curves)
             tailShape.moveTo(0, -0.2); 
             tailShape.quadraticCurveTo(0.5, 0.0, 0.7, 0.8); 
             tailShape.quadraticCurveTo(0.4, 0.7, 0, 0.5);   
             tailShape.quadraticCurveTo(-0.4, 0.7, -0.7, 0.8); 
             tailShape.quadraticCurveTo(-0.5, 0.0, 0, -0.2);   
            
             // Extrude settings with bevel
             const extrudeSettings = { depth: 0.06, bevelEnabled: true, bevelSize: 0.02, bevelSegments: 2 };
             const geometry = new THREE.ExtrudeGeometry(tailShape, extrudeSettings);
             geometry.center(); // Center
             geometry.scale(1.1, 1.1, 1.1); // Adjust size
             geometry.computeVertexNormals();
             return geometry;
        }

        // Dorsal Fin (Top): Extruded custom shape with bevel
        function createDorsalFinGeometry() {
             const dorsalFinShape = new THREE.Shape();
             // Define 2D shape
             dorsalFinShape.moveTo(-0.2,0); // Base start
             dorsalFinShape.lineTo(-0.15, 0.6); // Straight up part
             dorsalFinShape.quadraticCurveTo(0.1, 0.75, 0.4, 0.5); // Curve back down
             dorsalFinShape.lineTo(0.3, 0); // Base end
             dorsalFinShape.lineTo(-0.2,0); // Close shape
            
             const extrudeSettings = { depth: 0.05, bevelEnabled: true, bevelSize: 0.015, bevelSegments: 2 };
             const geometry = new THREE.ExtrudeGeometry(dorsalFinShape, extrudeSettings);
             geometry.center();
             geometry.computeVertexNormals();
             return geometry;
        }

        // Pelvic Fins (Bottom/Small): Extruded simple shape with bevel
        function createPelvicFinGeometry() {
            const finShape = new THREE.Shape();
            // Define 2D shape (smaller, simpler than pectoral)
            finShape.moveTo(0, 0);
            finShape.lineTo(0.1, 0.4);
            finShape.lineTo(0.0, 0.5);
            finShape.lineTo(-0.1, 0.4);
            finShape.lineTo(0, 0);

            const extrudeSettings = { depth: 0.03, bevelEnabled: true, bevelSize: 0.01, bevelSegments: 1 }; 
            const geometry = new THREE.ExtrudeGeometry(finShape, extrudeSettings);
            geometry.center(); 
            geometry.rotateX(Math.PI / 2); 
            geometry.scale(0.6, 0.6, 0.6); // Make them small
            geometry.computeVertexNormals();
            return geometry;
        }

        // --- Material Creation Function ---
        function createBubblesMaterial(isFinOrTail = false) {
            const material = new THREE.ShaderMaterial({
                vertexShader: bubblesVertexShader,
                fragmentShader: bubblesFragmentShader,
                uniforms: THREE.UniformsUtils.merge([ // Merge with built-in uniforms if needed later
                     {
                        uTime: { value: 0.0 },
                        uBaseColor: { value: new THREE.Color(0xFF7000) },   // Vibrant Orange
                        uStripeColor: { value: new THREE.Color(0xFFFFFF) },
                        uBorderColor: { value: new THREE.Color(0x0A0A0A) }, // Very dark border
                        uNoiseFactor: { value: 0.08 }, // Subtle noise intensity
                        uIsFinOrTail: { value: isFinOrTail ? 1.0 : 0.0 }
                     }
                ]),
                 lights: false // Set to true if you want THREE.js to pass light uniforms automatically (requires shader adjustments)
                // wireframe: true, // Uncomment for debugging
            });
            // Clone the material for fins/tail to ensure they have independent uniform instances if needed
            // Although currently uIsFinOrTail handles the difference, cloning is safer practice
             return isFinOrTail ? material.clone() : material; 
        }

        // --- Character Assembly Function ---
        function createBubblesCharacter() {
            const group = new THREE.Group();

            // Body
            const bodyGeometry = createBubblesBodyGeometry();
            const bodyMaterial = createBubblesMaterial(false);
            const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
            group.add(body);
            group.userData.bodyMaterial = bodyMaterial; // Store reference if needed

            // Pectoral Fins
            const pectoralFinGeo = createPectoralFinGeometry();
            const pectoralFinMat = createBubblesMaterial(true);
            const leftFin = new THREE.Mesh(pectoralFinGeo, pectoralFinMat);
            leftFin.position.set(0.6, -0.05, 0.35); 
            leftFin.rotation.y = Math.PI / 6; 
            leftFin.rotation.z = -Math.PI / 8; 
            group.add(leftFin);
            group.userData.leftFin = leftFin; 

            const rightFin = new THREE.Mesh(pectoralFinGeo, pectoralFinMat.clone()); 
            rightFin.position.x *= -1;
            rightFin.rotation.y *= -1; // Mirror rotation
            group.add(rightFin);
            group.userData.rightFin = rightFin; 

            // Tail Fin
            const tailGeo = createTailGeometry();
            const tailMat = createBubblesMaterial(true);
            const tail = new THREE.Mesh(tailGeo, tailMat);
            tail.position.set(0, 0.1, -1.15); 
            tail.rotation.x = Math.PI / 2; // Orient based on shape definition
            group.add(tail);
            group.userData.tail = tail; 

            // Dorsal Fin
            const dorsalFinGeo = createDorsalFinGeometry();
            const dorsalFinMat = createBubblesMaterial(true);
            const dorsalFin = new THREE.Mesh(dorsalFinGeo, dorsalFinMat);
            dorsalFin.position.set(0, 0.55, -0.1); // Position on top, slightly forward
            dorsalFin.rotation.y = Math.PI / 2; // Point forward
            group.add(dorsalFin);
            group.userData.dorsalFin = dorsalFin;

            // Pelvic Fins (Small bottom fins)
            const pelvicFinGeo = createPelvicFinGeometry();
            const pelvicFinMat = createBubblesMaterial(true);
            const leftPelvicFin = new THREE.Mesh(pelvicFinGeo, pelvicFinMat);
            leftPelvicFin.position.set(0.25, -0.45, 0.1); // Position bottom-forward
            leftPelvicFin.rotation.y = -Math.PI / 12; // Slight angle outward
            leftPelvicFin.rotation.z = Math.PI / 10; // Slight angle downward
            group.add(leftPelvicFin);
            group.userData.leftPelvicFin = leftPelvicFin;

            const rightPelvicFin = new THREE.Mesh(pelvicFinGeo, pelvicFinMat.clone());
            rightPelvicFin.position.x *= -1;
            rightPelvicFin.rotation.y *= -1;
            group.add(rightPelvicFin);
            group.userData.rightPelvicFin = rightPelvicFin;

            // Eyes
            const eyeGeometry = new THREE.SphereGeometry(0.16, 24, 18); // Slightly larger, smoother
            const eyeMaterial = new THREE.MeshStandardMaterial({ 
                color: 0xffffff, roughness: 0.1, metalness: 0.0 
            });
            const leftEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
            leftEye.position.set(0.40, 0.18, 0.85); 
            group.add(leftEye);

            const pupilGeometry = new THREE.SphereGeometry(0.075, 18, 14); // Proportionally adjusted pupil
            const pupilMaterial = new THREE.MeshStandardMaterial({ color: 0x050505 }); // Very dark
            const leftPupil = new THREE.Mesh(pupilGeometry, pupilMaterial);
            leftPupil.position.z = 0.14; // Position slightly forward on eye surface
            leftEye.add(leftPupil); 

            const rightEye = leftEye.clone(); // Clones eye and its child pupil
            rightEye.position.x *= -1;
            group.add(rightEye);
            
            group.userData.leftPupil = leftPupil;
            group.userData.rightPupil = rightEye.children[0]; 

            return group;
        }

        // --- Animation Function ---
        function animateBubbles(character, time) {
            // Update time uniform in all materials that use it
            const materialsToUpdate = [
                character.userData.bodyMaterial,
                character.userData.leftFin?.material,
                character.userData.rightFin?.material,
                character.userData.tail?.material,
                character.userData.dorsalFin?.material,
                character.userData.leftPelvicFin?.material,
                character.userData.rightPelvicFin?.material
            ];
            materialsToUpdate.forEach(mat => {
                if (mat?.uniforms?.uTime) {
                    mat.uniforms.uTime.value = time;
                }
            });

            // Animation parameters
            const tailSwayFrequency = 2.8; const tailSwayAmplitude = 0.75;
            const finFlutterFrequency = 6.5; const finFlutterAmplitude = 0.55;
            const bodyBobFrequency = 2.0; const bodyBobAmplitude = 0.05;
            const dorsalSwayFrequency = 1.2; const dorsalSwayAmplitude = 0.06;
            const pelvicFlutterFrequency = 7.0; const pelvicFlutterAmplitude = 0.2;

            // Apply animations
            const tail = character.userData.tail;
            if (tail) { tail.rotation.y = Math.sin(time * tailSwayFrequency) * tailSwayAmplitude; }

            const leftFin = character.userData.leftFin;
            const rightFin = character.userData.rightFin;
            if (leftFin && rightFin) {
                const finAngle = Math.sin(time * finFlutterFrequency + 0.2) * finFlutterAmplitude; // Added phase offset
                // Rotate around local Y axis assuming geometry is centered and oriented flat initially
                leftFin.rotation.y = Math.PI / 6 + finAngle; 
                rightFin.rotation.y = -Math.PI / 6 - finAngle; 
            }

            const dorsalFin = character.userData.dorsalFin;
            if (dorsalFin) { // Gentle side-to-side sway
                dorsalFin.rotation.z = Math.sin(time * dorsalSwayFrequency + 0.5) * dorsalSwayAmplitude; 
            }

             const leftPelvicFin = character.userData.leftPelvicFin;
             const rightPelvicFin = character.userData.rightPelvicFin;
             if (leftPelvicFin && rightPelvicFin) { // Subtle flutter for small fins
                 const pelvicAngle = Math.sin(time * pelvicFlutterFrequency + 0.8) * pelvicFlutterAmplitude;
                 // Rotate around local Y axis
                 leftPelvicFin.rotation.y = -Math.PI / 12 + pelvicAngle;
                 rightPelvicFin.rotation.y = Math.PI / 12 - pelvicAngle;
             }

            // Bob the whole character group up and down
            character.position.y = Math.sin(time * bodyBobFrequency) * bodyBobAmplitude;
        }


        // --- Initialization ---
        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x3498DB); // Lighter blue background
            scene.fog = new THREE.Fog(0x3498DB, 15, 40); // Match fog to background

            camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 100); 
            camera.position.set(0, 1.0, 5); // Position for good view

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            renderer.toneMapping = THREE.ACESFilmicToneMapping; // Use tone mapping for better color/lighting
            renderer.outputEncoding = THREE.sRGBEncoding; // Ensure correct color output
            document.body.appendChild(renderer.domElement);

            // Lighting Setup (Adjusted for tone mapping)
            const ambientLight = new THREE.AmbientLight(0x80B0FF, 0.5); // Less intense ambient
            scene.add(ambientLight);
            const hemisphereLight = new THREE.HemisphereLight(0xB0D0FF, 0x1A4070, 0.4); 
            scene.add(hemisphereLight);
            // Main directional light - slightly warmer
            const directionalLight = new THREE.DirectionalLight(0xFFF5E0, 1.2); 
            directionalLight.position.set(5, 10, 6);
            scene.add(directionalLight);
            // Add a softer fill light from the other side/bottom if needed
            // const fillLight = new THREE.DirectionalLight(0x80A0CC, 0.3);
            // fillLight.position.set(-5, -5, -5);
            // scene.add(fillLight);


            // Controls
            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.target.set(0, 0.3, 0); // Adjust target slightly

            // Create Character
            bubblesCharacter = createBubblesCharacter();
            scene.add(bubblesCharacter);

            window.addEventListener('resize', onWindowResize);
        }

        // --- Resize Handler ---
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // --- Animation Loop ---
        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();

            if (bubblesCharacter) {
                animateBubbles(bubblesCharacter, elapsedTime);
            }
            
            controls.update(); 
            renderer.render(scene, camera);
        }

        // --- Start ---
        init();
        animate();

    </script>
</body>
