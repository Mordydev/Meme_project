# Success Kid Community Platform Environment Configuration
# This is an example environment file. Copy to .env.local and update values.

# Node Environment
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Backend Configuration
PORT=3001
DATABASE_URL=postgresql://dev:dev@localhost:5432/successKidPlatform
REDIS_URL=redis://localhost:6379
CLERK_SECRET_KEY=sk_test_your_key_here
JWT_SECRET=dev-jwt-secret

# Security Configuration
CORS_ORIGIN=http://localhost:3000

# Docker Configuration
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=successKidPlatform

# API Keys for External Services
DEXSCREENER_API_KEY=your_key_here
SOLSCAN_API_KEY=your_key_here

# Webhooks
WEBHOOK_SECRET=your_webhook_secret_here
