# Success Kid Community Platform Staging Environment Configuration

# Node Environment
NODE_ENV=production

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://staging-api.successkid.com/api
NEXT_PUBLIC_WS_URL=wss://staging-api.successkid.com/ws
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${STAGING_CLERK_PUBLISHABLE_KEY}

# Backend Configuration
PORT=3001
DATABASE_URL=${STAGING_DATABASE_URL}
REDIS_URL=${STAGING_REDIS_URL}
CLERK_SECRET_KEY=${STAGING_CLERK_SECRET_KEY}
JWT_SECRET=${STAGING_JWT_SECRET}

# Security Configuration
CORS_ORIGIN=https://staging.successkid.com

# Docker Configuration (only relevant for local Docker Compose)
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_password
POSTGRES_DB=successKidPlatform_staging

# API Keys for External Services
DEXSCREENER_API_KEY=${STAGING_DEXSCREENER_API_KEY}
SOLSCAN_API_KEY=${STAGING_SOLSCAN_API_KEY}

# Webhooks
WEBHOOK_SECRET=${STAGING_WEBHOOK_SECRET}
