# Generic Settings
NODE_ENV=development
PORT=3001
HOST=localhost
LOG_LEVEL=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=success_kid
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=success_kid:

# Authentication Settings
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1d
SESSION_SECRET=your-session-secret
SESSION_TTL=86400

# Points System Configuration
POINTS_LIMIT_CONTENT_CREATION=200
POINTS_LIMIT_COMMENT=150
POINTS_LIMIT_UPVOTE=100
POINTS_LIMIT_LOGIN=20
POINTS_LIMIT_ACHIEVEMENT=1000
POINTS_LIMIT_REFERRAL=500
POINTS_LIMIT_PROFILE=100
POINTS_LIMIT_WALLET=50
POINTS_LIMIT_STREAK=100
POINTS_LIMIT_EVENT=500
POINTS_DEFAULT_LIMIT=100

# Redemption Configuration
WEEKLY_REDEMPTION_CAP=10000
MIN_REDEMPTION_AMOUNT=1000
POINTS_TO_TOKEN_RATE=100
AUTO_APPROVE_THRESHOLD=5000
ESTIMATED_PROCESSING_TIME="24 hours"

# Blockchain Configuration
TREASURY_ADDRESS=your-treasury-wallet-address
TREASURY_PRIVATE_KEY=your-encrypted-treasury-private-key
TOKEN_ADDRESS=your-token-contract-address
TOKEN_DECIMALS=9
MIN_CONFIRMATIONS=1
GAS_MULTIPLIER=1.1
BLOCKCHAIN_PROVIDER_URLS=https://api.mainnet-beta.solana.com,https://solana-mainnet.phantom.tech/,https://solana.maizlabs.xyz
BLOCK_EXPLORER_URL=https://solana.fm/
TRANSACTION_WAIT_TIMEOUT=60000

# Security Settings
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000
