# Server configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
BASE_URL=http://localhost:3001

# CORS configuration
CORS_ORIGIN=http://localhost:3000,http://frontend:3000

# Database configuration
DATABASE_URL=postgres://dev:dev@localhost:5432/successKidPlatform
# Optional PostgreSQL configuration
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# Redis configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=sk:

# Authentication
JWT_SECRET=your-very-secret-key-change-in-production

# Feature flags
# Enable/disable features (true/false)
FEATURE_POINTS_REDEMPTION=true
FEATURE_POINTS_TRANSFER=false
FEATURE_CONTENT_MODERATION=false

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000 # 1 minute in milliseconds

# Trusted IPs that bypass rate limiting (comma-separated)
TRUSTED_PROXIES=127.0.0.1

# Media Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 Storage Configuration (uncomment and set values if using S3)
# S3_BUCKET_NAME=media-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_CDN_BASE_URL=

# Upload Limits
UPLOAD_MAX_FILE_SIZE=10485760 # 10MB
UPLOAD_IMAGE_MAX_SIZE=10485760 # 10MB
UPLOAD_VIDEO_MAX_SIZE=104857600 # 100MB
UPLOAD_DOCUMENT_MAX_SIZE=20971520 # 20MB

# Allowed MIME Types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/ogg,audio/wav,audio/webm