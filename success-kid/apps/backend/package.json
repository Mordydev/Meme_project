{
  "name": "@success-kid/backend",
  "version": "1.0.0",
  "description": "Backend API for the Success Kid Community Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "node migrations/migration.js",
    "migrate:create": "node -e \"require('fs').writeFileSync('migrations/'+(new Date().toISOString().replace(/[-T:Z.]/g,'').substring(0,14))+'_'+process.argv[1]+'.sql', '-- Migration: '+process.argv[1]+'\\n\\n')\" "
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.1",
    "@fastify/websocket": "^8.2.0",
    "@neondatabase/serverless": "^1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/blob": "^0.27.3",
    "bull": "^4.12.0",
    "bullmq": "^4.17.0",
    "cron": "^3.1.6",
    "dotenv": "^16.4.1",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.6.0",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@fastify/compress": "^8.0.1",
    "@types/bull": "^4.10.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
