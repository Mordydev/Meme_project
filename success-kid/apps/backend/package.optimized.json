{
  "name": "@success-kid/backend",
  "version": "1.0.0",
  "description": "Backend API for the Success Kid Community Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "jest",
    "test:unit": "jest --testPathPattern=src/__tests__/(?!integration)",
    "test:integration": "jest --testPathPattern=src/__tests__/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:performance": "node src/testing/performance/api-performance.js",
    "migrate": "node migrations/migration.js",
    "migrate:create": "node -e \"require('fs').writeFileSync('migrations/'+(new Date().toISOString().replace(/[-T:Z.]/g,'').substring(0,14))+'_'+process.argv[1]+'.sql', '-- Migration: '+process.argv[1]+'\\n\\n')\" ",
    "docs:generate": "node scripts/generate-swagger-docs.js",
    "validate:openapi": "openapi-validator dist/openapi.json",
    "load:test": "k6 run src/testing/performance/load-test.js"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^10.0.0",
    "@fastify/rate-limit": "^8.0.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.1",
    "bull": "^4.12.2",
    "dotenv": "^16.4.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/node": "^22.3.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "autocannon": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "k6": "^0.0.0",
    "nodemon": "^3.1.0",
    "openapi-validator": "^0.6.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
