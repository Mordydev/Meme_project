FROM node:22-alpine

# Set working directory
WORKDIR /app

# Install global dependencies
RUN npm install -g pnpm@latest

# Install dependencies first, leveraging Docker cache
COPY package.json pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY packages ./packages/

# Install dependencies - two step process for better workspace resolution
RUN pnpm install --no-frozen-lockfile

# Build shared packages first
RUN pnpm --filter="@success-kid/config" build
RUN pnpm --filter="@success-kid/types" build
RUN pnpm --filter="@success-kid/utils" build

# Verify nodemon installation
RUN ls -la /app/apps/backend/node_modules/nodemon/bin/
RUN test -f /app/apps/backend/node_modules/nodemon/bin/nodemon.js || (echo "Nodemon binary not found" && exit 1)

# Copy application source code
COPY apps/backend ./apps/backend

# Set environment variables
ENV NODE_ENV=development
ENV PORT=3001
ENV HOST=0.0.0.0

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

# Start application in development mode with hot reloading
CMD ["pnpm", "--filter", "@success-kid/backend", "dev"]