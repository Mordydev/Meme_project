FROM node:22-alpine

# Set working directory
WORKDIR /app

# Install global dependencies
RUN npm install -g pnpm@latest

# Install dependencies first, leveraging Docker cache
COPY package.json pnpm-workspace.yaml ./
COPY apps/frontend/package.json ./apps/frontend/
COPY packages ./packages/

# Install dependencies - two step process for better workspace resolution
RUN pnpm install --no-frozen-lockfile

# Build shared packages first
RUN pnpm --filter="@success-kid/config" build
RUN pnpm --filter="@success-kid/types" build
RUN pnpm --filter="@success-kid/utils" build
RUN pnpm --filter="@success-kid/ui" build

# Verify Next.js installation
RUN ls -la /app/apps/frontend/node_modules/next/dist/bin/
RUN test -f /app/apps/frontend/node_modules/next/dist/bin/next || (echo "Next.js binary not found" && exit 1)

# Copy application source code
COPY apps/frontend ./apps/frontend

# Set environment variables
ENV NODE_ENV=development
ENV NEXT_PUBLIC_API_URL=http://backend:3001

# Expose port
EXPOSE 3000

# Start application in development mode with hot reloading
CMD ["pnpm", "--filter", "frontend", "dev"]