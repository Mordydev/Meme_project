{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node Library",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "es2019",
    "lib": ["es2019", "es2020"],
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".turbo"]
}